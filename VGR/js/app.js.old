          <th rowspan="2">#</th><th rowspan="2">Company</th>
          <th rowspan="2" style="text-align:right">Turnover</th>
          <th rowspan="2" style="text-align:right">Player Win/Loss</th>
          <th rowspan="2" style="text-align:right">System Profit</th>
          <th rowspan="2" style="text-align:right">Master Profit</th>
          <th colspan="3" style="text-align:center;background:var(--bg)">Vigor</th>
        </tr>
        <tr>
          <th style="text-align:right;background:var(--bg)">Transfer</th>
          <th style="text-align:right;background:var(--bg)">Profit</th>
          <th style="text-align:right;background:var(--bg)">Total Bill</th>
        </tr>
      </thead><tbody>
      ${rows}
      <tr style="font-weight:700;background:var(--bg)">
        <td colspan="2">Grand Total</td>
        <td style="text-align:right">0</td><td style="text-align:right;color:var(--green)">0</td>
        <td style="text-align:right;color:var(--green)">0</td><td style="text-align:right">0</td>
        <td style="text-align:right">0</td><td style="text-align:right;color:var(--green)">0</td><td style="text-align:right;font-weight:700">0</td>
      </tr>
      </tbody></table>`)}
    </div>
  </div>`;
};

pages['reports-limit-credit'] = () => {
  const rows = COMPANIES.map((c,i) => {
    const limit = rnd(5,50)*1000000; const used = Math.round(limit*rnd(20,110)/100);
    const pct = Math.round(used/limit*100);
    return `<tr>
      <td>${i+1}</td><td><strong>${c}</strong></td>
      <td style="text-align:right">${fmt(limit)}</td>
      <td style="text-align:right">${fmt(used)}</td>
      <td style="text-align:right;color:${used>limit?'var(--red)':'var(--green)'}">${fmt(Math.max(0,limit-used))}</td>
      <td><div style="display:flex;align-items:center;gap:.5rem"><div style="flex:1;height:5px;background:var(--border);border-radius:3px;min-width:60px"><div style="width:${Math.min(pct,100)}%;height:100%;background:${pct>90?'var(--red)':pct>70?'var(--yellow)':'var(--green)'};border-radius:3px"></div></div><span style="font-size:.72rem">${pct}%</span></div></td>
      <td>${badge(pct>100?'Blocked':pct>90?'Warning':'OK',pct>100?'red':pct>90?'yellow':'green')}</td>
    </tr>`;
  }).join('');
  return `
  ${pageHeader('Limit Credit Report', '<span>Reports</span><span class="sep">›</span><span>Limit Credit Report</span>')}
  ${reportFilterRow()}
  <div class="card">
    <div class="card-header"><span class="card-title">Limit Credit Report</span>${reportExportBtns()}</div>
    <div class="card-body">
      ${tableWrap(`<table><thead><tr><th>#</th><th>Agent</th><th style="text-align:right">Credit Limit</th><th style="text-align:right">Used</th><th style="text-align:right">Remaining</th><th>Usage %</th><th>Status</th></tr></thead><tbody>
      ${rows}
      </tbody></table>`)}
    </div>
  </div>`;
};

