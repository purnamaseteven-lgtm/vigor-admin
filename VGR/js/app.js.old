const pages = {};

/* ─── DASHBOARD ─── */
pages['dashboard'] = () => {
  const totalMembers = STATE.members.length;
  const activeMembers = STATE.members.filter(m=>m.status==='Active').length;
  const totalDeposit = STATE.deposits.filter(d=>d.status==='Approved').reduce((s,d)=>s+d.amount,0);
  const pendingDeposit = STATE.deposits.filter(d=>d.status==='Pending').length;
  const totalWithdraw = STATE.withdrawals.filter(w=>w.status==='Approved').reduce((s,w)=>s+w.amount,0);
  const pendingWithdraw = STATE.withdrawals.filter(w=>w.status==='Pending').length;
  const activeCompanies = STATE.companies.filter(c=>c.status==='Active').length;
  const activeBanks = STATE.banks.filter(b=>b.status==='Active').length;
  return `
${pageHeader('Dashboard','<span>Home</span><span class="sep">›</span><span>Dashboard</span>',
  `<button class="btn btn-secondary btn-sm"><i class="fa-solid fa-calendar"></i> Apr 2026</button>
   <button class="btn btn-primary btn-sm" onclick="go('dashboard')"><i class="fa-solid fa-rotate-right"></i> Refresh</button>`
)}
<div class="stat-grid">
  <div class="stat-card" style="cursor:pointer" onclick="go('global-member-list')">
    <div class="stat-icon blue"><i class="fa-solid fa-users"></i></div>
    <div><div class="stat-label">Total Members</div><div class="stat-value">${fmt(totalMembers)}</div>
    <div class="stat-change up"><i class="fa-solid fa-circle-check"></i> ${activeMembers} active</div></div>
  </div>
  <div class="stat-card" style="cursor:pointer" onclick="go('deposit-list')">
    <div class="stat-icon green"><i class="fa-solid fa-arrow-down-to-bracket"></i></div>
    <div><div class="stat-label">Total Deposit</div><div class="stat-value">${fmtCur(totalDeposit)}</div>
    <div class="stat-change ${pendingDeposit>0?'down':'up'}"><i class="fa-solid fa-clock"></i> ${pendingDeposit} pending</div></div>
  </div>
  <div class="stat-card" style="cursor:pointer" onclick="go('withdrawal-list')">
    <div class="stat-icon red"><i class="fa-solid fa-arrow-up-from-bracket"></i></div>
    <div><div class="stat-label">Total Withdraw</div><div class="stat-value">${fmtCur(totalWithdraw)}</div>
    <div class="stat-change ${pendingWithdraw>0?'down':'up'}"><i class="fa-solid fa-clock"></i> ${pendingWithdraw} pending</div></div>
  </div>
  <div class="stat-card"><div class="stat-icon yellow"><i class="fa-solid fa-chart-line"></i></div>
    <div><div class="stat-label">Turnover</div><div class="stat-value">${fmtCur(totalDeposit+totalWithdraw)}</div>
    <div class="stat-change up"><i class="fa-solid fa-arrow-up"></i> 8.7%</div></div>
  </div>
  <div class="stat-card"><div class="stat-icon purple"><i class="fa-solid fa-coins"></i></div>
    <div><div class="stat-label">GGR (Revenue)</div><div class="stat-value">${fmtCur(Math.round((totalDeposit-totalWithdraw)*0.07))}</div>
    <div class="stat-change up"><i class="fa-solid fa-arrow-up"></i> 5.3%</div></div>
  </div>
  <div class="stat-card" style="cursor:pointer" onclick="go('company-list')">
    <div class="stat-icon indigo"><i class="fa-solid fa-building"></i></div>
    <div><div class="stat-label">Active Companies</div><div class="stat-value">${activeCompanies}</div>
    <div class="stat-change up"><i class="fa-solid fa-building-columns"></i> ${activeBanks} banks active</div></div>
  </div>
</div>
<div class="chart-grid chart-grid-2">
  <div class="card"><div class="card-header"><span class="card-title"><i class="fa-solid fa-chart-line text-blue"></i> Agent Activity</span></div><div class="card-body"><div class="chart-container" style="height:220px"><canvas id="chartAgents"></canvas></div></div></div>
  <div class="card"><div class="card-header"><span class="card-title"><i class="fa-solid fa-users text-green"></i> Member Growth</span></div><div class="card-body"><div class="chart-container" style="height:220px"><canvas id="chartMembers"></canvas></div></div></div>
</div>
<div class="chart-grid chart-grid-2">
  <div class="card"><div class="card-header"><span class="card-title"><i class="fa-solid fa-arrows-up-down text-yellow"></i> Deposit & Withdraw Count</span></div><div class="card-body"><div class="chart-container" style="height:220px"><canvas id="chartDWCount"></canvas></div></div></div>
  <div class="card"><div class="card-header"><span class="card-title"><i class="fa-solid fa-sack-dollar text-purple"></i> Deposit & Withdraw Value</span></div><div class="card-body"><div class="chart-container" style="height:220px"><canvas id="chartDWValue"></canvas></div></div></div>
</div>
<div class="chart-grid chart-grid-3">
  <div class="card"><div class="card-header"><span class="card-title"><i class="fa-solid fa-rotate text-indigo"></i> Turnover</span></div><div class="card-body"><div class="chart-container" style="height:200px"><canvas id="chartTurnover"></canvas></div></div></div>
  <div class="card"><div class="card-header"><span class="card-title"><i class="fa-solid fa-chart-pie text-yellow"></i> Agent Revenue Ratio</span></div><div class="card-body"><div class="chart-container" style="height:200px"><canvas id="chartAgentRatio"></canvas></div></div></div>
  <div class="card"><div class="card-header"><span class="card-title"><i class="fa-solid fa-chart-pie text-green"></i> GGR Total</span></div><div class="card-body"><div class="chart-container" style="height:200px"><canvas id="chartGGR"></canvas></div></div></div>
</div>
<div class="chart-grid chart-grid-2">
  <div class="card"><div class="card-header"><span class="card-title"><i class="fa-solid fa-dice text-blue"></i> Bet Count</span></div><div class="card-body"><div class="chart-container" style="height:200px"><canvas id="chartBetCount"></canvas></div></div></div>
  <div class="card"><div class="card-header"><span class="card-title"><i class="fa-solid fa-star text-yellow"></i> Player Activity by Hour</span></div><div class="card-body"><div class="chart-container" style="height:200px"><canvas id="chartHourly"></canvas></div></div></div>
</div>`;
