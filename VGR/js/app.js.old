pages['custom-template'] = () => {
  let activeId = 'custom';
  const cards = TEMPLATES.map(t => `
    <div class="card" id="tcard-${t.id}" style="cursor:pointer;overflow:hidden;transition:box-shadow .18s,border-color .18s;border:2px solid ${t.active?'var(--acc)':'var(--border)'}">
      <!-- Preview thumbnail -->
      <div style="height:160px;overflow:hidden;position:relative;background:${t.bg}">
        ${t.preview}
        ${t.active?`<div style="position:absolute;top:6px;right:6px;background:var(--acc);color:#fff;font-size:.65rem;font-weight:700;padding:.2rem .5rem;border-radius:4px">✓ ACTIVE</div>`:''}
        <div style="position:absolute;inset:0;background:rgba(0,0,0,0);transition:background .2s" onmouseover="this.style.background='rgba(0,0,0,.15)'" onmouseout="this.style.background='rgba(0,0,0,0)'"></div>
      </div>
      <!-- Info -->
      <div style="padding:.6rem .75rem .4rem">
        <div style="font-size:.82rem;font-weight:700;color:var(--text)">${t.name}</div>
        <div style="font-size:.7rem;color:var(--text3);margin-top:.15rem">In use: <strong>${t.inUse}</strong></div>
      </div>
      <!-- Color swatches -->
      <div style="display:flex;gap:.3rem;padding:.3rem .75rem .5rem;align-items:center">
        ${t.colors.map(c=>`<div style="width:16px;height:16px;border-radius:50%;background:${c};border:1px solid rgba(0,0,0,.15);cursor:pointer" title="${c}"></div>`).join('')}
        <div style="margin-left:auto;display:flex;gap:.3rem">
          <button class="btn btn-sm btn-secondary btn-icon" onclick="previewTemplate('${t.id}')" title="Preview"><i class="fa-solid fa-eye"></i></button>
          <button class="btn btn-sm ${t.active?'btn-primary':'btn-secondary'}" onclick="applyTemplate('${t.id}',this)" style="font-size:.72rem;padding:.25rem .6rem">${t.active?'Active':'Apply'}</button>
        </div>
      </div>
    </div>`).join('');

  return `
  ${pageHeader('Template List', '<span>Customization</span><span class="sep">›</span><span>Template List</span>',
    `<div class="search-box"><i class="fa-solid fa-magnifying-glass"></i><input type="text" placeholder="Search template..." oninput="filterTemplates(this.value)"/></div>`
  )}
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem" id="templateGrid">
    ${cards}
  </div>`;
};

function applyTemplate(id, btn) {
  // remove active from all
  TEMPLATES.forEach(t => {
    t.active = false;
    const card = document.getElementById('tcard-' + t.id);
    if (card) card.style.borderColor = 'var(--border)';
  });
  const t = TEMPLATES.find(x => x.id === id);
  if (t) {
    t.active = true;
    const card = document.getElementById('tcard-' + id);
    if (card) card.style.borderColor = 'var(--acc)';
  }
  document.querySelectorAll('#templateGrid button:last-child').forEach(b => {
    b.textContent = 'Apply'; b.className = 'btn btn-sm btn-secondary';
  });
  btn.textContent = 'Active'; btn.className = 'btn btn-sm btn-primary';
  toast(`Template "${t?.name}" applied to your site!`, 'success');
}

function previewTemplate(id) {
  const t = TEMPLATES.find(x => x.id === id);
  openModal(`Preview: ${t.name}`,
    `<div style="border:1px solid var(--border);border-radius:8px;overflow:hidden;height:200px;background:${t.bg}">${t.preview}</div>
     <div class="mt-2">
       <div class="text-sm font-semibold">${t.name}</div>
       <div class="text-xs text-muted mt-1">Currently in use by ${t.inUse} company(s)</div>
       <div style="display:flex;gap:.4rem;margin-top:.5rem">${t.colors.map(c=>`<div style="width:20px;height:20px;border-radius:50%;background:${c};border:1px solid rgba(0,0,0,.15)"></div>`).join('')}</div>
     </div>`,
    `<button class="btn btn-primary" onclick="applyTemplate('${id}',this);closeModalBtn()">Apply This Template</button>
     <button class="btn btn-secondary" onclick="closeModalBtn()">Close</button>`
  );
}

function filterTemplates(q) {
  const lq = q.toLowerCase();
  TEMPLATES.forEach(t => {
    const card = document.getElementById('tcard-' + t.id);
    if (card) card.style.display = (!lq || t.name.toLowerCase().includes(lq)) ? '' : 'none';
  });
}

/* ─── CUSTOMIZATION: GLOBAL BANNER ─── */
/* banner state */
let bannerState = { tab: 'Home', desktopBanners: { Home: [{ url:'https://cdn.vigor.gaming/banner-home.png', preview:true }], Sports:[], Togel:[], Slot:[], Casino:[], 'Fishing Game':[], Others:[] }, mobileBanners: { Home:[], Sports:[], Togel:[], Slot:[], Casino:[], 'Fishing Game':[], Others:[] } };
const BANNER_TABS = ['Home','Sports','Togel','Slot','Casino','Fishing Game','Others'];
const NO_SUPPORT_TABS = { desktop:['Togel'], mobile:['Togel'] };

pages['custom-global-banner'] = () => renderGlobalBanner();

function renderGlobalBanner() {
  const tab = bannerState.tab;
  const dBanners = bannerState.desktopBanners[tab] || [];
  const mBanners = bannerState.mobileBanners[tab] || [];
  const noSupportD = NO_SUPPORT_TABS.desktop.includes(tab);
  const noSupportM = NO_SUPPORT_TABS.mobile.includes(tab);

  function dropZone(id, banners, noSupport) {
    const previews = banners.map((b,i) => `
      <div style="position:relative;display:inline-block;margin:.3rem">
        <div style="width:120px;height:60px;border-radius:6px;overflow:hidden;border:1px solid var(--border);background:#f1f5f9;display:flex;align-items:center;justify-content:center">
          <div style="font-size:.6rem;color:var(--text3);text-align:center;padding:.25rem;word-break:break-all">${b.url.split('/').pop()}</div>
        </div>
        <button onclick="removeBanner('${id}',${i})" style="position:absolute;top:-6px;right:-6px;width:18px;height:18px;border-radius:50%;background:var(--red);color:#fff;border:none;font-size:.6rem;cursor:pointer;display:flex;align-items:center;justify-content:center">×</button>
      </div>`).join('');
    return `
      ${noSupport ? '<div style="font-size:.8rem;color:var(--text3);margin-bottom:.5rem">No support</div>' : ''}
      <div id="drop-${id}"
        ondragover="event.preventDefault();this.style.borderColor='var(--acc)'"
        ondragleave="this.style.borderColor='var(--border)'"
        ondrop="handleBannerDrop(event,'${id}')"
        onclick="document.getElementById('file-${id}').click()"
        style="border:2px dashed var(--border);border-radius:8px;padding:1.5rem;text-align:center;cursor:pointer;background:var(--bg);transition:border-color .18s;min-height:100px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.35rem${noSupport?';opacity:.4;pointer-events:none':''}">
        ${previews || `<div style="font-size:.8rem;color:var(--text3)">Drag 'n' drop some files here, or click to select files</div><div style="font-size:.72rem;color:var(--text3)">(Only *.image will be accepted)</div>`}
      </div>
      <input type="file" id="file-${id}" accept="image/*" style="display:none" onchange="handleBannerFile(event,'${id}')"/>
      <div style="display:flex;gap:.5rem;margin-top:.5rem;align-items:center">
        <input type="text" id="url-${id}" placeholder="Enter URL  http://www.example.com/banner.png"
          style="flex:1;border:1px solid var(--border);border-radius:7px;padding:.45rem .65rem;font-size:.8rem;outline:none"
          onfocus="this.style.borderColor='var(--acc)'" onblur="this.style.borderColor='var(--border)'"/>
        <button class="btn btn-success btn-sm" onclick="addBannerURL('${id}')">Add</button>
      </div>
      <div style="text-align:right;margin-top:.5rem">
        <button class="btn btn-success btn-sm" onclick="toast('Banners updated!','success')"><i class="fa-solid fa-rotate-right"></i> Update</button>
      </div>`;
  }

  return `
  ${pageHeader('Global Banners', '<span>Customization</span><span class="sep">›</span><span>Global Banners</span>')}
  <div class="card">
    <div class="card-body">
      <!-- Template selector -->
      <div style="margin-bottom:1rem">
        <div style="font-size:.78rem;font-weight:600;color:var(--text2);margin-bottom:.35rem">Templates List</div>
        <select style="border:1px solid var(--border);border-radius:7px;padding:.45rem .75rem;font-size:.82rem;outline:none;min-width:280px">
          ${TEMPLATES.map(t=>`<option>${t.name.toUpperCase()}</option>`).join('')}
        </select>
      </div>
      <!-- Tabs -->
      <div class="tab-bar" style="margin-bottom:1.25rem">
        ${BANNER_TABS.map(t=>`<div class="tab-btn${bannerState.tab===t?' active':''}" onclick="switchBannerTab('${t}')">${t}</div>`).join('')}
      </div>
      <!-- Desktop Banners -->
      <div style="margin-bottom:1.5rem">
        <div style="font-size:.875rem;font-weight:700;color:var(--text);margin-bottom:.3rem">Desktop Banners</div>
        <div style="font-size:.72rem;color:var(--text3);margin-bottom:.75rem">Recommended image dimension: 1920 × 550 and HD quality. Max 3MB</div>
        ${dropZone('d-'+tab, dBanners, noSupportD)}
      </div>
      <!-- Mobile Banners -->
      <div>
        <div style="font-size:.875rem;font-weight:700;color:var(--text);margin-bottom:.3rem">Mobile Banners</div>
        <div style="font-size:.72rem;color:var(--text3);margin-bottom:.75rem">Recommended image dimension: 1080 × 720 and HD quality. Max 3MB</div>
        ${dropZone('m-'+tab, mBanners, noSupportM)}
      </div>
    </div>
  </div>`;
}

function switchBannerTab(tab) {
  bannerState.tab = tab;
  document.getElementById('pageContent').innerHTML = renderGlobalBanner();
}
function addBannerURL(id) {
  const inp = document.getElementById('url-'+id);
  if (!inp || !inp.value.trim()) { toast('Please enter a valid URL','error'); return; }
  const [type, tab] = id.split('-').length === 2 ? [id.split('-')[0], id.split('-')[1]] : [id.split('-')[0], id.split('-').slice(1).join('-')];
  const arr = type==='d' ? bannerState.desktopBanners : bannerState.mobileBanners;
  const tabKey = Object.keys(arr).find(k => k.replace(/\s/g,'-').toLowerCase() === tab.toLowerCase()) || bannerState.tab;
  arr[tabKey] = arr[tabKey] || [];
  arr[tabKey].push({ url: inp.value.trim() });
  toast('Banner URL added!','success');
  document.getElementById('pageContent').innerHTML = renderGlobalBanner();
}
function removeBanner(id, idx) {
  const [type] = id.split('-');
  const arr = type==='d' ? bannerState.desktopBanners : bannerState.mobileBanners;
  const tab = bannerState.tab;
  if (arr[tab]) arr[tab].splice(idx, 1);
  document.getElementById('pageContent').innerHTML = renderGlobalBanner();
  toast('Banner removed','info');
}
function handleBannerDrop(e, id) {
  e.preventDefault();
  document.getElementById('drop-'+id).style.borderColor = 'var(--border)';
  const file = e.dataTransfer.files[0];
  if (!file) return;
  if (!file.type.startsWith('image/')) { toast('Only image files are accepted','error'); return; }
  const [type] = id.split('-');
  const arr = type==='d' ? bannerState.desktopBanners : bannerState.mobileBanners;
  const tab = bannerState.tab;
  arr[tab] = arr[tab] || [];
  arr[tab].push({ url: file.name });
  toast(`${file.name} uploaded!`,'success');
  document.getElementById('pageContent').innerHTML = renderGlobalBanner();
}
function handleBannerFile(e, id) {
  const file = e.target.files[0];
  if (!file) return;
  handleBannerDrop({ preventDefault:()=>{}, dataTransfer:{ files:[file] } }, id);
}

/* ─── CUSTOMIZATION: PROMOTION LIST ─── */
const PROMO_CATS = ['Special','New Member','Event Provider','Cockfight','Crash','Sports','Slot','Casino','Fishing Game'];

pages['custom-promotion-list'] = () => {
  const pg='custom-promotion-list', pp=getPerPage(pg), cp=getCurPage(pg);
  const all=filterData(STATE.promotions,pg);
  const rows=paginate(all,cp,pp).map((p,i)=>`<tr>
    <td style="color:var(--text3)">${(cp-1)*pp+i+1}</td>
    <td>${badge(p.cat,'blue')}</td>
    <td><a href="#" onclick="return false" style="color:var(--acc);font-size:.78rem">${p.title}</a></td>
    <td style="white-space:nowrap;font-size:.75rem">${p.created}</td>
    <td style="white-space:nowrap;font-size:.75rem">${p.display}</td>
    <td>${badge(p.status,p.status==='Active'?'green':'gray')}</td>
    <td>
      <div class="action-btns">
        <button class="btn btn-sm btn-icon" style="background:#f59e0b;color:#fff" onclick="editPromotion('${p.id}')"><i class="fa-solid fa-pen"></i></button>
        <button class="btn btn-sm btn-danger btn-icon" onclick="deletePromotion('${p.id}')"><i class="fa-solid fa-trash"></i></button>
        <button class="btn btn-sm btn-secondary btn-icon" onclick="togglePromotionStatus('${p.id}')" title="Toggle status"><i class="fa-solid fa-toggle-on"></i></button>
      </div>
    </td>
  </tr>`).join('');
  return `
  ${pageHeader('Global Promotion','<span>Customization</span><span class="sep">›</span><span>Global Promotion</span>',
    `<button class="btn btn-success" onclick="addPromotion()"><i class="fa-solid fa-plus"></i> Add Promotion</button>`)}
  ${filterCard(`${fsSelect(pg,'status','Status',['All','Active','Inactive'],'120px')} ${fsSelect(pg,'cat','Category',['All',...PROMO_CATS],'160px')} ${fsInput(pg,'_search','Search','Title…','200px')} ${fsActions(pg)}`)}
  <div class="card">
    <div class="card-header"><span class="card-title">Promotion List</span><span class="text-sm text-muted">${all.length} promotions · ${STATE.promotions.filter(p=>p.status==='Active').length} active</span><button class="btn btn-sm btn-secondary btn-icon" onclick="exportCSV(STATE.promotions,'promotions.csv')"><i class="fa-solid fa-download"></i></button></div>
    <div class="card-body">
      ${tableWrap(`<table><thead><tr><th>#</th><th>Category</th><th>Title</th><th>Created Date</th><th>Display Date</th><th>Status</th><th>Action</th></tr></thead><tbody>${rows||'<tr><td colspan="7" style="text-align:center;color:var(--text3)">No promotions found</td></tr>'}</tbody></table>`)}
      ${renderPagerHTML(pg,all.length,pp,cp)}
    </div>
  </div>`;
};

function addPromotion() {
  openFormModal('Add Promotion',[
    {name:'cat',label:'Category',type:'select',options:PROMO_CATS,value:'Special'},
    {name:'title',label:'Title',required:true,placeholder:'Promotion title'},
    {name:'display',label:'Display Date',type:'datetime-local'},
    {name:'status',label:'Status',type:'select',options:['Active','Inactive'],value:'Active'},
  ],()=>{
    const t=fmVal('title').trim();if(!t){toast('Title required','error');return;}
    const now=new Date().toLocaleString('id-ID',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'});
    stateAdd('promotions',{id:'PRO'+String(Date.now()).slice(-4),cat:fmVal('cat'),title:t,created:now,display:fmVal('display')||now,status:fmVal('status')});
    addLog('Add Promotion',t,'Created promotion category: '+fmVal('cat'));
    closeModalBtn();go(currentPage);toast('Promotion added!','success');
  });
}

function editPromotion(id) {
  const p=STATE.promotions.find(x=>x.id===id);if(!p)return;
  openFormModal('Edit Promotion',[
    {name:'id',hidden:true,value:p.id},
    {name:'cat',label:'Category',type:'select',options:PROMO_CATS,value:p.cat},
    {name:'title',label:'Title',value:p.title},
    {name:'status',label:'Status',type:'select',options:['Active','Inactive'],value:p.status},
  ],()=>{
    stateUpdate('promotions',fmVal('id'),{cat:fmVal('cat'),title:fmVal('title'),status:fmVal('status')});
    addLog('Edit Promotion',p.title,'Category: '+fmVal('cat')+' Status: '+fmVal('status'));
    closeModalBtn();go(currentPage);toast('Updated!','success');
  },{saveLabel:'Update'});
}

function deletePromotion(id) {
  const p=STATE.promotions.find(x=>x.id===id);if(!p)return;
  if(!confirm('Delete this promotion?'))return;
  stateDelete('promotions',id);addLog('Delete Promotion',p.title,'Deleted');
  go(currentPage);toast('Deleted','info');
}

function togglePromotionStatus(id) {
  const p=STATE.promotions.find(x=>x.id===id);if(!p)return;
  const next=p.status==='Active'?'Inactive':'Active';
  stateUpdate('promotions',id,{status:next});
  addLog('Toggle Promotion',p.title,`Status → ${next}`);
  go(currentPage);toast(`${p.title.slice(0,30)}… → ${next}`,'info');
}

