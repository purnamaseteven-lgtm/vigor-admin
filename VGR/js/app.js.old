</div>`;

/* ─── RESULTS SCAN ─── */
pages['results-scan'] = () => `
${pageHeader('Scan Result', '<span>Results</span><span class="sep">›</span><span>Scan Result</span>')}
<div class="card">
  <div class="card-body">
    <div style="display:flex;align-items:flex-end;flex-wrap:wrap;gap:.75rem">
      <div class="filter-group" style="margin:0">
        <label>Togel Type</label>
        <div style="display:flex;gap:.75rem;align-items:center;padding:.4rem 0">
          <label style="display:flex;align-items:center;gap:.3rem;font-size:.82rem;cursor:pointer"><input type="radio" name="srtype" checked/> 4D</label>
          <label style="display:flex;align-items:center;gap:.3rem;font-size:.82rem;cursor:pointer"><input type="radio" name="srtype"/> 6D</label>
        </div>
      </div>
      ${filterSelect('Pool',['SE-SE-SEOUL','HK-HONGKONG','SY-SYDNEY','ID-ID-INDIA','PCSO'],'200px')}
      ${filterSelect('Period',['SE-1412','SE-1411','SE-1410','SE-1409'],'160px')}
      ${filterSelect('Profit (min)',['Profit (min)','0','100000','500000','1000000'],'150px')}
      ${filterSelect('Profit (max)',['Profit (max)','1000000','5000000','10000000'],'150px')}
      ${filterSelect('Total Profit',['Total Profit','Ascending','Descending'],'150px')}
      ${filterSelect('Order',['ASC','DESC'],'100px')}
      <div class="filter-actions" style="align-self:flex-end">
        <button class="btn btn-primary" onclick="toast('Scanning...','info')"><i class="fa-solid fa-magnifying-glass"></i> Scan</button>
        <button class="btn btn-danger" onclick="toast('Reset','info')"><i class="fa-solid fa-rotate-left"></i> Reset</button>
      </div>
    </div>
  </div>
</div>
<div class="card" style="min-height:300px">
  <div class="card-body" style="display:flex;align-items:center;justify-content:center;min-height:280px">
