      ${rows}
      <tr style="font-weight:700;background:var(--bg)">
        <td colspan="2">Grand Total</td>
        <td style="text-align:right;color:var(--red)">-28,097</td>
        <td style="text-align:right">91,995</td>
        <td style="text-align:right">30,000</td>
        <td style="text-align:right">0</td>
        <td style="text-align:right;font-weight:700">67,985</td>
