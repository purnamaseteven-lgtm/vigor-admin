  <div class="form-card">
    <div class="card-header"><span class="card-title">${name} Integration</span></div>
    <div class="card-body">
      <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> Configure the ${name} integration settings below.</div>
      <div class="form-grid">${fields}</div>
    </div>
    <div class="form-footer">
      <button class="btn btn-primary" onclick="toast('${name} settings saved!','success')"><i class="fa-solid fa-check"></i> Save</button>
      <button class="btn btn-success" onclick="toast('Connection tested','success')"><i class="fa-solid fa-plug"></i> Test Connection</button>
    </div>
  </div>`;
}

