/* ─── COMPANY CREATE ─── */
pages['company-create'] = () => `
${pageHeader('Create Company', '<span>Company</span><span class="sep">›</span><span>Create</span>')}
<div class="form-card">
  <div class="card-header"><span class="card-title">Company Information</span></div>
  <div class="card-body">
    <div class="form-grid">
      <div class="form-grid form-grid-2">
        <div class="form-field"><label>Username *</label><input id="cc_username" type="text" placeholder="Enter username"/></div>
        <div class="form-field"><label>Company Name</label><input id="cc_name" type="text" placeholder="Enter company name"/></div>
      </div>
      <div class="form-grid form-grid-2">
        <div class="form-field"><label>Email</label><input id="cc_email" type="email" placeholder="admin@company.id"/></div>
        <div class="form-field"><label>Phone</label><input id="cc_phone" type="text" placeholder="0812xxxxxxxx"/></div>
      </div>
      <div class="form-grid form-grid-2">
        <div class="form-field"><label>Initial Credit (Rp)</label><input id="cc_credit" type="number" placeholder="0" value="0"/></div>
        <div class="form-field"><label>Domain / URL</label><input id="cc_domain" type="text" placeholder="https://example.com"/></div>
      </div>
      <div class="form-field"><label>Status</label><select id="cc_status"><option>Active</option><option>Inactive</option></select></div>
    </div>
  </div>
  <div class="form-footer">
    <button class="btn btn-primary" onclick="saveCompanyForm()"><i class="fa-solid fa-check"></i> Create</button>
    <button class="btn btn-secondary" onclick="go('company-list')">Cancel</button>
  </div>
</div>`;

function saveCompanyForm() {
  const u = document.getElementById('cc_username')?.value?.trim();
  const n = document.getElementById('cc_name')?.value?.trim();
  if (!u) { toast('Username required','error'); return; }
  stateAdd('companies',{id:'C'+String(Date.now()).slice(-5),username:u,name:n||u+' Gaming',
    email:document.getElementById('cc_email')?.value||'',phone:document.getElementById('cc_phone')?.value||'',
    credit:parseInt(document.getElementById('cc_credit')?.value)||0,members:0,
    status:document.getElementById('cc_status')?.value||'Active',
    type:'Company',joined:new Date().toLocaleDateString('id-ID')});
  toast('Company created!','success');go('company-list');
}

