function switchCommDetailTab(el, tab) {
  el.closest('.tab-bar').querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
  el.classList.add('active');
  const PROVIDERS_MAP = {
    Sports: ['Saba Platform (89%)','SBO Sportsbook (88.5%)','Virtual Sports (85.5%)','TFGaming (92%)','Sports38 (90%)','AFB1188 Sport (89%)'],
    Slot: ['PRAGMATIC PLAY (92%)','HABANERO (90%)','MICROGAMING (91%)','NETENT (92%)','SPADEGAMING (90%)','PLAY\'N GO (91%)'],
    Fishing: ['JDB Fishing (88%)','Joker Fishing (87%)','CQ9 Fishing (89%)'],
    Casino: ['Evolution Gaming (88%)','SA Gaming (87%)','Sexy Baccarat (86%)','Dream Gaming (87%)','WM Casino (88%)'],
    Others: ['Lottery (85%)','Keno (84%)','Virtual Racing (86%)'],
  };
  const providers = PROVIDERS_MAP[tab] || [];
  const rows = providers.map((p,i) => `<tr>
    <td>${i+1}</td><td>${p}</td>
    <td><div style="display:flex;align-items:center;gap:.35rem"><input type="number" value="80" style="width:70px;border:1px solid var(--border);border-radius:5px;padding:.3rem .5rem;text-align:right;outline:none"/><span style="font-size:.8rem;color:var(--text2)">%</span></div></td>
    <td style="color:var(--text3)">0</td>
    <td><button class="btn btn-sm btn-icon" style="background:var(--acc);color:#fff;border:none;cursor:pointer;border-radius:6px;padding:.3rem .45rem" onclick="toast('Commission updated!','success')"><i class="fa-regular fa-pen-to-square"></i></button></td>
  </tr>`).join('');
  document.getElementById('commDetailTab').innerHTML = `<div class="table-wrapper"><table><thead><tr><th>#</th><th>Provider</th><th>Commission</th><th>Old Commission</th><th>Action</th></tr></thead><tbody>` + rows + `</tbody></table></div>`;
}

