/* ─── MEMO ─── */
let memoFolder = 'inbox';
let memoReadId = null;

pages['memo-list'] = () => renderMemoPage();

function renderMemoPage() {
  const items = STATE.memos[memoFolder] || [];
  const unread = STATE.memos.inbox.filter(m=>!m.read).length;
  return `
  <div style="display:grid;grid-template-columns:220px 1fr;gap:1rem;align-items:start">
    <!-- Left sidebar -->
    <div>
      <button class="btn btn-danger w-full" style="margin-bottom:.75rem;font-weight:700" onclick="openComposeMemo()">
        <i class="fa-solid fa-pen-to-square"></i> Compose
      </button>
      <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden">
        ${[['inbox','fa-inbox','Inbox'],['sent','fa-paper-plane','Sent'],['trash','fa-trash','Trash']].map(([f,ic,lb]) => `
        <div onclick="switchMemoFolder('${f}')" style="display:flex;align-items:center;gap:.65rem;padding:.6rem 1rem;cursor:pointer;background:${memoFolder===f?'var(--acc)':'transparent'};color:${memoFolder===f?'#fff':'var(--text2)'};transition:background .15s">
          <i class="fa-solid ${ic}" style="width:16px;text-align:center"></i>
          <span style="font-size:.82rem;font-weight:500">${lb}</span>
          ${f==='inbox'&&unread>0?`<span style="margin-left:auto;background:${memoFolder===f?'rgba(255,255,255,.3)':'var(--acc)'};color:#fff;font-size:.65rem;font-weight:700;padding:.1rem .4rem;border-radius:99px">${unread}</span>`:''}
        </div>`).join('')}
      </div>
    </div>
    <!-- Right content -->
    <div class="card">
      <div class="card-body">
        ${memoReadId ? renderMemoDetail(memoReadId) : renderMemoList(items)}
      </div>
    </div>
  </div>`;
}

function renderMemoList(items) {
  return `
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.875rem">
      <div style="font-size:.875rem;font-weight:700;color:var(--text)">${memoFolder.charAt(0).toUpperCase()+memoFolder.slice(1)} <span class="badge badge-blue">${items.length}</span></div>
      ${memoFolder==='inbox'?`<button class="btn btn-sm btn-danger" onclick="deleteAllMemos()"><i class="fa-solid fa-trash"></i> Delete All</button>`:''}
    </div>
    ${tableWrap(`<table><thead><tr><th style="width:24px"></th><th>Date</th><th>${memoFolder==='sent'?'To':'From'}</th><th>Category</th><th>Subject</th><th>Action</th></tr></thead><tbody>
    ${items.length ? items.map((m,i) => `<tr style="cursor:pointer;${!m.read&&memoFolder==='inbox'?'font-weight:600;background:rgba(14,165,233,.04)':''}" onclick="openMemoDetail('${m.id}')">
      <td><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${!m.read&&memoFolder==='inbox'?'var(--acc)':'transparent'}"></span></td>
      <td style="white-space:nowrap;font-size:.75rem">${m.date}</td>
      <td style="font-size:.78rem;font-weight:600">${memoFolder==='sent'?(m.to||'—'):m.from}</td>
      <td>${badge(m.category,'blue')}</td>
      <td style="font-size:.78rem">${m.subject}</td>
      <td onclick="event.stopPropagation()">
        <button class="btn btn-sm btn-danger btn-icon" onclick="deleteMemoItem('${m.id}')"><i class="fa-solid fa-trash"></i></button>
      </td>
    </tr>`).join('') : `<tr><td colspan="6"><div class="table-empty"><i class="fa-regular fa-envelope-open"></i><p>No messages in ${memoFolder}</p></div></td></tr>`}
    </tbody></table>`)}`;
}

function renderMemoDetail(id) {
  const m = STATE.memos[memoFolder].find(x=>x.id===id);
  if (!m) { memoReadId=null; return renderMemoList(STATE.memos[memoFolder]||[]); }
  m.read = true;
  return `
    <div style="margin-bottom:.75rem">
      <button class="btn btn-sm btn-secondary" onclick="memoReadId=null;document.getElementById('pageContent').innerHTML=renderMemoPage()"><i class="fa-solid fa-arrow-left"></i> Back</button>
    </div>
    <div style="border:1px solid var(--border);border-radius:8px;padding:1rem">
      <div style="font-size:1rem;font-weight:700;color:var(--text);margin-bottom:.75rem">${m.subject}</div>
      <div style="display:flex;gap:2rem;font-size:.78rem;color:var(--text2);margin-bottom:.75rem">
        <span><strong>From:</strong> ${m.from||'—'}</span>
        <span><strong>Date:</strong> ${m.date}</span>
        <span><strong>Category:</strong> ${m.category}</span>
      </div>
      <div style="font-size:.85rem;color:var(--text);line-height:1.7;padding:.75rem;background:var(--bg);border-radius:6px">${(m.body||m.subject).replace(/\n/g,'<br>')}</div>
      <div style="margin-top:1rem;display:flex;gap:.5rem">
        <button class="btn btn-sm btn-primary" onclick="openComposeMemo('${memoFolder==='inbox'?m.from:m.to}','Re: ${m.subject.replace(/'/g,"\\'")}')"><i class="fa-solid fa-reply"></i> Reply</button>
        <button class="btn btn-sm btn-danger" onclick="deleteMemoItem('${m.id}')"><i class="fa-solid fa-trash"></i> Delete</button>
      </div>
    </div>`;
}

function openMemoDetail(id) {
  memoReadId = id;
  document.getElementById('pageContent').innerHTML = renderMemoPage();
}

function switchMemoFolder(folder) {
  memoFolder = folder; memoReadId = null;
  document.getElementById('pageContent').innerHTML = renderMemoPage();
}

function deleteAllMemos() {
  if(!confirm('Delete all messages in inbox?'))return;
  STATE.memos.inbox = [];
  document.getElementById('pageContent').innerHTML = renderMemoPage();
  toast('All messages deleted','info');
}

function deleteMemoItem(id) {
  STATE.memos[memoFolder] = STATE.memos[memoFolder].filter(m=>m.id!==id);
  memoReadId = null;
  document.getElementById('pageContent').innerHTML = renderMemoPage();
  toast('Deleted','info');
}

function openComposeMemo(toVal='', subjVal='') {
  openFormModal('Compose Memo',[
    {name:'to',label:'To (Agent / Username)',required:true,placeholder:'Recipient',value:toVal},
    {name:'subject',label:'Subject',required:true,placeholder:'Subject',value:subjVal},
    {name:'category',label:'Category',type:'select',options:['General','Finance','System'],value:'General'},
    {name:'body',label:'Message',type:'textarea',placeholder:'Write your message…'},
  ],()=>{
    const to=fmVal('to').trim(), subj=fmVal('subject').trim();
    if(!to||!subj){toast('To and Subject are required','error');return;}
    const now=new Date().toLocaleDateString('id-ID',{day:'2-digit',month:'2-digit',year:'numeric'})+' '+new Date().toLocaleTimeString('id-ID');
    STATE.memos.sent.unshift({id:'MSNT'+Date.now(),date:now,from:'adminsub40',to,category:fmVal('category'),subject:subj,body:fmVal('body'),read:true});
    addLog('Send Memo',to,'Subject: '+subj);
    toast('Memo sent to '+to+'!','success');
    closeModalBtn();
    switchMemoFolder('sent');
  });
}

/* ─── AUTO MEMO ─── */
pages['memo-auto'] = () => `
${pageHeader('Auto Memo', '<span>Memo</span><span class="sep">›</span><span>Auto Memo</span>')}
<!-- Content Tags info -->
<div class="card" style="margin-bottom:1rem">
  <div class="card-header"><span class="card-title"><i class="fa-solid fa-tag text-blue"></i> Content Tags</span></div>
  <div class="card-body" style="font-size:.8rem;color:var(--text2);line-height:1.8">
    <p style="margin-bottom:.4rem">Use these tags to put to your content. When displaying on your site, it will actual value / words.</p>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-top:.5rem">
      ${[
        ['{company_name}','It is your site name. Name in your profile.'],
        ['{min_deposit}','It is minimum deposit that you set in Bank Account Management > Limit Settings.'],
        ['{site_label}','display current site label (this year).'],
      ].map(([tag,desc]) => `
        <div style="background:var(--bg);border-radius:7px;padding:.5rem .75rem">
          <code style="color:var(--acc);font-size:.78rem;font-weight:700">${tag}</code>
          <div style="font-size:.72rem;color:var(--text3);margin-top:.2rem">${desc}</div>
        </div>`).join('')}
    </div>
  </div>
</div>
<!-- Auto Memo Form -->
<div class="card" style="max-width:900px">
  <div class="card-header"><span class="card-title">Auto Memo</span></div>
  <div class="card-body">
    <div class="form-grid">
      <div class="form-field"><label>Title</label>
        <select style="border:1px solid var(--border);border-radius:7px;padding:.45rem .65rem;font-size:.82rem;outline:none">
          <option>Welcome New Member</option>
          <option>Deposit Success Notification</option>
          <option>Withdraw Approved</option>
          <option>Credit Limit Warning</option>
          <option>New Promotion Available</option>
        </select>
      </div>
      <div class="form-field"><label>Subject</label>
        <input type="text" value="Selamat Datang!" style="border:1px solid var(--border);border-radius:7px;padding:.45rem .65rem;font-size:.82rem;outline:none"/>
      </div>
      <div class="form-field"><label>Condition</label>
        <input type="text" value="Process: Registration Successful" readonly style="border:1px solid var(--border);border-radius:7px;padding:.45rem .65rem;font-size:.82rem;outline:none;background:var(--bg);color:var(--text3)"/>
      </div>
      <div class="form-field">
        <label>Content</label>
        <!-- Simple rich-text toolbar -->
        <div style="border:1px solid var(--border);border-radius:7px;overflow:hidden">
          <div style="display:flex;flex-wrap:wrap;gap:2px;padding:.4rem .5rem;background:var(--bg);border-bottom:1px solid var(--border)">
            ${['fa-bold','fa-italic','fa-underline','fa-strikethrough','|','fa-align-left','fa-align-center','fa-align-right','|','fa-list-ul','fa-list-ol','|','fa-link','fa-image','fa-code'].map(ic => ic==='|'
              ? `<span style="width:1px;background:var(--border);margin:0 3px"></span>`
              : `<button onclick="return false" style="width:26px;height:26px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:.72rem;color:var(--text2);border:none;background:none;cursor:pointer" onmouseover="this.style.background='var(--border)'" onmouseout="this.style.background='none'"><i class="fa-solid ${ic}"></i></button>`
            ).join('')}
          </div>
          <textarea rows="8" style="width:100%;border:none;padding:.75rem;font-size:.82rem;outline:none;resize:vertical;color:var(--text)">Selamat datang di {company_name}!

Status deposit terkecil dahulu untuk memulai permainan di {company_name}.
Sebagai member di {company_name} anda juga,
Minimum deposit Rp {min_deposit}.

Terima kasih.

Congratulations! Your account is active.

Now you can play to the game on {company_name}.
Minimum deposit Rp {min_deposit}.

Thanks you.</textarea>
        </div>
      </div>
    </div>
  </div>
  <div class="form-footer">
    <button class="btn btn-success" onclick="toast('Auto memo saved!','success')"><i class="fa-solid fa-check"></i> Submit</button>
    <button class="btn btn-danger" onclick="toast('Reset','info')"><i class="fa-solid fa-rotate-left"></i> Reset</button>
  </div>
</div>`;

/* ─── REPORTS ─── */
function reportFilterRow(extraFilters='') {
  return `<div class="filter-card"><div class="filter-row">
    ${filterInput('Search','Company / Name','200px')}
    <div class="filter-group"><label>Date Range</label>
      <div style="display:flex;align-items:center;gap:.3rem">
        <i class="fa-regular fa-calendar" style="color:var(--text3)"></i>
        <input type="text" value="27/04/2026 - 27/04/2026" style="border:1px solid var(--border);border-radius:7px;padding:.4rem .65rem;font-size:.8rem;outline:none;width:200px"/>
      </div>
    </div>
    ${extraFilters}
    <label class="toggle" style="align-self:flex-end;gap:.5rem;margin-bottom:.1rem">
      <input type="checkbox"/><div class="toggle-slider"></div>
      <span style="font-size:.75rem;color:var(--text2);white-space:nowrap">Show Company/Whitelabel Inactive</span>
    </label>
    <div class="filter-actions" style="align-self:flex-end">
      <button class="btn btn-primary" onclick="toast('Searching...','info')"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
    </div>
  </div></div>`;
}

function reportExportBtns(exportFn='') {
  return `<div class="flex gap-1">
    ${exportFn?`<button class="btn btn-sm btn-secondary btn-icon" onclick="${exportFn}" title="Export CSV"><i class="fa-solid fa-file-excel"></i></button>`:''}
    <button class="btn btn-sm btn-secondary btn-icon" onclick="toast('PDF export coming soon','info')"><i class="fa-solid fa-file-pdf"></i></button>
    <button class="btn btn-sm btn-secondary btn-icon" onclick="window.print()"><i class="fa-solid fa-print"></i></button>
  </div>`;
}

pages['reports-agent-daily'] = () => {
  // Aggregate real STATE data by company
  const companyNames = [...new Set(STATE.companies.map(c=>c.username))];
  const reportData = companyNames.map(co => {
    const members = STATE.members.filter(m=>m.company===co).length;
    const deps = STATE.deposits.filter(d=>d.company===co);
    const wits = STATE.withdrawals.filter(w=>w.company===co);
    const depAmt = deps.filter(d=>d.status==='Approved').reduce((s,d)=>s+d.amount,0);
    const witAmt = wits.filter(w=>w.status==='Approved').reduce((s,w)=>s+w.amount,0);
    const wl = depAmt - witAmt;
    return {company:co,members,newUsers:rnd(0,5),depCount:deps.length,witCount:wits.length,depAmt,witAmt,wl,turnover:depAmt+witAmt};
  }).filter(r=>r.depCount>0||r.members>0);
  const totalDep = reportData.reduce((s,r)=>s+r.depAmt,0);
  const totalWit = reportData.reduce((s,r)=>s+r.witAmt,0);
  const rows = reportData.map((r,i) => `<tr>
    <td>${i+1}</td>
    <td><strong>${r.company}</strong><br><span style="font-size:.7rem;color:var(--text3)">${r.company}.vigor.gaming</span></td>
    <td style="text-align:right">${r.members}</td><td style="text-align:right">${r.newUsers}</td>
    <td style="text-align:right">${r.depCount}</td><td style="text-align:right">${r.witCount}</td>
    <td style="text-align:right;color:var(--green)">${fmt(r.depAmt)}</td><td style="text-align:right;color:var(--red)">${fmt(r.witAmt)}</td>
    <td style="text-align:right;color:${r.wl>=0?'var(--green)':'var(--red)'}">${r.wl>=0?'+':''}${fmt(r.wl)}</td>
    <td style="text-align:right">${fmt(r.turnover)}</td>
  </tr>`).join('');
  return `
  ${pageHeader('Agent Daily Report', '<span>Reports</span><span class="sep">›</span><span>Agent Daily Report</span>')}
  ${reportFilterRow()}
  <div class="card">
    <div class="card-header"><span class="card-title">Agent Daily Report</span>
      ${reportExportBtns("exportCSV(STATE.deposits,'deposits_export.csv')")}
    </div>
    <div class="card-body">
      ${tableWrap(`<table><thead><tr>
        <th>#</th><th>Company / Whitelabel</th>
        <th style="text-align:right">Total Members</th><th style="text-align:right">New Users</th>
        <th style="text-align:right">Deposit Count</th><th style="text-align:right">Withdraw Count</th>
        <th style="text-align:right">Total Deposit</th><th style="text-align:right">Total Withdraw</th>
        <th style="text-align:right">Player Win/Loss</th><th style="text-align:right">Turnover</th>
      </tr></thead><tbody>
      ${rows||'<tr><td colspan="10" style="text-align:center;color:var(--text3)">No data</td></tr>'}
      <tr style="font-weight:700;background:var(--bg)">
        <td colspan="2">Grand Total</td>
        <td style="text-align:right">${fmt(STATE.members.length)}</td>
        <td style="text-align:right">—</td>
        <td style="text-align:right">${STATE.deposits.length}</td>
        <td style="text-align:right">${STATE.withdrawals.length}</td>
        <td style="text-align:right;color:var(--green)">${fmtCur(totalDep)}</td>
        <td style="text-align:right;color:var(--red)">${fmtCur(totalWit)}</td>
        <td style="text-align:right;color:${totalDep-totalWit>=0?'var(--green)':'var(--red)'}">${fmtCur(totalDep-totalWit)}</td>
        <td style="text-align:right">${fmtCur(totalDep+totalWit)}</td>
      </tr>
      </tbody></table>`)}
    </div>
  </div>`;
};

pages['reports-winloss'] = () => {
  const rows = COMPANIES.slice(0,6).map((c,i) => {
    const to = rnd(5,50)*1000000; const pwl = rnd(-3,3)*1000000;
    const sp = rnd(-1,5)*500000; const mp = rnd(0,3)*500000;
    const tr = rnd(0,2)*500000; const pr = rnd(0,3)*500000; const tb = sp+pr;
    return `<tr>
      <td>${i+1}</td><td><strong>${c}</strong></td>
      <td style="text-align:right">${fmt(to)}</td>
      <td style="text-align:right;color:${pwl>=0?'var(--green)':'var(--red)'}">${pwl>=0?'+':''}${fmt(pwl)}</td>
      <td style="text-align:right;color:${sp>=0?'var(--green)':'var(--red)'}">${sp>=0?'+':''}${fmt(sp)}</td>
      <td style="text-align:right">${fmt(mp)}</td>
      <td style="text-align:right">${fmt(tr)}</td>
      <td style="text-align:right;color:var(--green)">${fmt(pr)}</td>
      <td style="text-align:right;font-weight:700">${fmt(tb)}</td>
    </tr>`;
  }).join('');
  return `
