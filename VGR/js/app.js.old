        <div class="tab-btn" onclick="this.parentElement.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));this.classList.add('active');document.getElementById('refTabContent').innerHTML=refGameContent()">Referral Game</div>
      </div>
      <div id="refTabContent">
        <!-- Togel referral default -->
        <div class="alert" style="background:#fef9c3;border:1px solid #fde047;border-radius:7px;padding:.5rem .875rem;font-size:.78rem;color:#854d0e;margin-bottom:.875rem">*New referral rate will be applied immediately</div>
        <!-- 4D / 6D sub-tabs -->
        <div style="display:flex;gap:.3rem;margin-bottom:.875rem" id="refDimTabs">
          <button class="btn btn-primary btn-sm" onclick="this.parentElement.querySelectorAll('button').forEach(b=>{b.className='btn btn-secondary btn-sm'});this.className='btn btn-primary btn-sm'">4D</button>
