pages['settings-limit-credit-out'] = () => `
${pageHeader('Limit Credit Out', '<span>Settings</span><span class="sep">›</span><span>Limit Credit Out</span>')}
<div class="card">
  <div class="card-body">
    ${tableWrap(`<table><thead><tr><th>#</th><th>Agent</th><th>Current Credit</th><th>Limit</th><th>Usage %</th><th>Status</th><th>Action</th></tr></thead><tbody>
    ${COMPANIES.map((c,i) => {
      const limit = rnd(5,50)*1000000; const cur = Math.round(limit*(rnd(30,110)/100));
      const pct = Math.round(cur/limit*100);
      return `<tr><td>${i+1}</td><td>${c}</td><td>${fmtCur(cur)}</td><td>${fmtCur(limit)}</td>
      <td><div style="display:flex;align-items:center;gap:.5rem"><div style="flex:1;height:6px;background:var(--border);border-radius:3px"><div style="width:${Math.min(pct,100)}%;height:100%;background:${pct>90?'var(--red)':pct>70?'var(--yellow)':'var(--green)'};border-radius:3px"></div></div><span class="text-xs">${pct}%</span></div></td>
      <td>${badge(pct>100?'Blocked':pct>90?'Warning':'OK',pct>100?'red':pct>90?'yellow':'green')}</td>
      <td><button class="btn btn-sm btn-primary" onclick="toast('Limit updated','success')"><i class="fa-solid fa-pen"></i></button></td>
    </tr>`;}).join('')}
    </tbody></table>`)}
  </div>
</div>`;

/* ─── CUSTOMIZATION: SITE CONFIG ─── */
/* Site Config configures the PLAYER-FACING website, not the admin panel */
pages['custom-site-config'] = () => {
  function scRow(label, input, note='') {
    return `<div style="display:grid;grid-template-columns:240px 1fr;align-items:center;gap:1rem;padding:.55rem 1rem;border-bottom:1px solid var(--border)">
      <div style="font-size:.8rem;color:var(--text2)">${label}</div>
      <div>${input}${note?`<div style="font-size:.7rem;color:var(--text3);margin-top:.2rem">${note}</div>`:''}</div>
    </div>`;
  }
  function scToggle(label, checked=true, note='') {
    return scRow(label, `<label class="toggle"><input type="checkbox" ${checked?'checked':''} onchange="toast('${label} updated','success')"/><div class="toggle-slider"></div></label>`, note);
  }
  function scInput(label, val, type='text', note='') {
    return scRow(label, `<input type="${type}" value="${val}" style="border:1px solid var(--border);border-radius:7px;padding:.4rem .65rem;font-size:.82rem;width:100%;max-width:400px;outline:none" onfocus="this.style.borderColor='var(--acc)'" onblur="this.style.borderColor='var(--border)'"/>`, note);
  }
  function scSelect(label, options, selected='', note='') {
    return scRow(label, `<select style="border:1px solid var(--border);border-radius:7px;padding:.4rem .65rem;font-size:.82rem;outline:none">${options.map(o=>`<option ${o===selected?'selected':''}>${o}</option>`).join('')}</select>`, note);
  }
  function scSection(title) {
    return `<div style="padding:.5rem 1rem;background:var(--bg);border-bottom:1px solid var(--border);font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text3)">${title}</div>`;
  }

  return `
  ${pageHeader('Site Config', '<span>Customization</span><span class="sep">›</span><span>Site Config</span>',
    `<button class="btn btn-success" onclick="toast('All settings saved!','success')"><i class="fa-solid fa-check"></i> Save All</button>`
  )}
  <div class="alert alert-info mb-2"><i class="fa-solid fa-circle-info"></i> These settings apply to the <strong>player-facing website</strong>. Changes are reflected live on your whitelabel site.</div>
  <div class="card" style="max-width:900px">

    ${scSection('General')}
    ${scInput('Site Name','VIGOR Gaming')}
    ${scInput('Site URL','https://vigor.gaming')}
    ${scInput('Logo URL','https://cdn.vigor.gaming/logo.png','text','Recommended: 200×50px PNG')}
    ${scInput('Favicon URL','https://cdn.vigor.gaming/favicon.ico','text','16×16 or 32×32 .ico file')}
    ${scInput('Meta Title','VIGOR – Situs Judi Online Terpercaya')}
    ${scInput('Meta Description','Main page SEO description','text','Max 160 characters')}
    ${scInput('Meta Keywords','judi online, slot, togel, casino','text','Comma-separated')}
    ${scSelect('Default Language',['Indonesian','English','Chinese','Thai'],'Indonesian')}
    ${scSelect('Timezone',['Asia/Jakarta','Asia/Singapore','Asia/Bangkok','Asia/Kuala_Lumpur'],'Asia/Jakarta')}

    ${scSection('Feature Toggles')}
    ${scToggle('Registration Open', true, 'Allow new players to register')}
    ${scToggle('Login Enabled', true)}
    ${scToggle('Deposit Enabled', true)}
    ${scToggle('Withdrawal Enabled', true)}
    ${scToggle('Live Chat', true, 'Show live chat widget on site')}
    ${scToggle('Referral Program', true)}
    ${scToggle('Promo Banner', true)}
    ${scToggle('Captcha on Login', true)}
    ${scToggle('Captcha on Register', false)}
    ${scToggle('Maintenance Mode', false, 'When ON, players see maintenance page')}

    ${scSection('Player Rules')}
    ${scInput('Min Deposit (Rp)','25000','number')}
    ${scInput('Max Deposit (Rp)','50000000','number')}
    ${scInput('Min Withdrawal (Rp)','50000','number')}
    ${scInput('Max Withdrawal (Rp)','25000000','number')}
    ${scInput('Max Daily Withdrawal (Rp)','50000000','number')}
    ${scInput('Min Password Length','8','number')}
    ${scToggle('Require Phone Number', true)}
    ${scToggle('Require Bank Account on Register', false)}

    ${scSection('Display')}
    ${scSelect('Theme / Template',['Custom Template','Flagship Store','Template 1','Template 2','Template 3','Template 4','Template 5'],'Custom Template','Active template for the player site')}
    ${scRow('Primary Color', `<div style="display:flex;align-items:center;gap:.5rem"><input type="color" oninput="syncColorPick(this)" value="#0ea5e9" style="width:36px;height:30px;border:1px solid var(--border);border-radius:6px;cursor:pointer;padding:2px"/><input type="text" oninput="syncColorText(this)" value="#0ea5e9" style="border:1px solid var(--border);border-radius:7px;padding:.4rem .65rem;font-size:.82rem;width:100px;outline:none"/></div>`)}
    ${scRow('Secondary Color', `<div style="display:flex;align-items:center;gap:.5rem"><input type="color" oninput="syncColorPick(this)" value="#0f172a" style="width:36px;height:30px;border:1px solid var(--border);border-radius:6px;cursor:pointer;padding:2px"/><input type="text" oninput="syncColorText(this)" value="#0f172a" style="border:1px solid var(--border);border-radius:7px;padding:.4rem .65rem;font-size:.82rem;width:100px;outline:none"/></div>`)}
    ${scToggle('Show Game Providers Logo', true)}
    ${scToggle('Show Running Text (Marquee)', true)}
    ${scToggle('Show Jackpot Ticker', false)}
    ${scToggle('Show VIP Level Badge', true)}
    ${scToggle('Dark Mode Option for Players', false)}
    ${scSelect('Games Per Page',['12','16','20','24','32'],'20')}

    ${scSection('Contact & Support')}
    ${scInput('WhatsApp Number','6281234567890')}
    ${scInput('Telegram Username','@vigorgaming')}
    ${scInput('Line ID','vigorgaming')}
    ${scInput('Email Support','support@vigor.gaming','email')}
    ${scInput('Live Chat Script URL','https://livechat.vigor.gaming/chat.js','text','Embed script URL')}

    ${scSection('SEO & Analytics')}
    ${scInput('Google Analytics ID','G-XXXXXXXXXX')}
    ${scInput('Facebook Pixel ID','')}
    ${scInput('Custom Head Script','','text','HTML injected into <head>')}
    ${scInput('Custom Footer Script','','text','HTML injected before </body>')}
    ${scToggle('Generate Sitemap', true)}
    ${scToggle('Allow Search Engines', false, 'If OFF, adds noindex meta tag')}

    ${scSection('Maintenance Page')}
    ${scInput('Maintenance Title','Sedang Dalam Perbaikan')}
    ${scInput('Maintenance Message','Mohon maaf, situs sedang dalam pemeliharaan. Silahkan kembali beberapa saat lagi.','text','')}
    ${scInput('Maintenance Image URL','')}

    <div style="padding:.875rem 1rem;display:flex;gap:.5rem">
      <button class="btn btn-primary" onclick="toast('All settings saved!','success')"><i class="fa-solid fa-check"></i> Save All Changes</button>
      <button class="btn btn-secondary" onclick="toast('Reset to defaults','info')"><i class="fa-solid fa-rotate-left"></i> Reset to Default</button>
    </div>
  </div>`;
};

