pages['reports-top-turnover'] = () => `
${pageHeader('Top Turnover Members', '<span>Reports</span><span class="sep">›</span><span>Top Turnover</span>')}
${filterCard(`${filterDate('From')} ${filterDate('To')} ${filterSelect('Company',['All',...COMPANIES.slice(0,5)])} ${filterActions()}`)}
<div class="card">
  <div class="card-body">
    ${tableWrap(`<table><thead><tr><th>Rank</th><th>Username</th><th>Company</th><th>Turnover</th><th>Win/Loss</th><th>Bet Count</th></tr></thead><tbody>
    ${MEMBERS.slice(0,10).map((m,i) => {
      const to = (10-i)*rnd(5,15)*1000000;
      return `<tr>
        <td><span style="width:24px;height:24px;border-radius:50%;background:${i<3?['#f59e0b','#94a3b8','#cd7f32'][i]:'var(--bg)'};color:${i<3?'#fff':'var(--text2)'};display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:.75rem">${i+1}</span></td>
        <td><strong>${m}</strong></td><td>${COMPANIES[i%COMPANIES.length]}</td>
        <td class="font-bold">${fmtCur(to)}</td>
