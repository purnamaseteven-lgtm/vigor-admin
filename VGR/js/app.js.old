  </div></div>
  <div class="card">
    <div class="card-header">
      <span class="card-title">Monthly Invoice List</span>
      <button class="btn btn-sm btn-secondary btn-icon" onclick="toast('Exporting...','info')"><i class="fa-solid fa-download"></i></button>
    </div>
    <div class="card-body">
      ${tableWrap(`<table><thead><tr>
        <th>#</th><th>Company</th>
        <th style="text-align:right">Player Win/Loss</th>
        <th style="text-align:right">Royalty</th>
        <th style="text-align:right">Promotions</th>
        <th style="text-align:right">Total Bill (Dealer Tips)</th>
