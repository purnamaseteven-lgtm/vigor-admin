</div>`;

/* ─── MONTHLY INVOICE ─── */
pages['invoice-tournament'] = () => `
${pageHeader('Tournament Winner List', '<span>Monthly Invoice</span><span class="sep">›</span><span>Tournament Winner List</span>')}
<div class="filter-card"><div class="filter-row">
  ${filterSelect('Provider',PROVIDERS,'180px')}
  <div class="filter-group"><label>Date Range</label>
    <div style="display:flex;align-items:center;gap:.3rem">
      <i class="fa-regular fa-calendar" style="color:var(--text3)"></i>
      <input type="text" value="01/04/2026 – 27/04/2026" style="border:1px solid var(--border);border-radius:7px;padding:.4rem .65rem;font-size:.8rem;outline:none;width:200px"/>
    </div>
  </div>
  ${filterInput('Username / Name','Enter Username / Name','180px')}
  <div class="filter-actions" style="align-self:flex-end">
    <button class="btn btn-primary" onclick="toast('Searching...','info')"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
  </div>
</div></div>
<div class="card">
  <div class="card-header">
    <span class="card-title">Tournament Winner List</span>
    <button class="btn btn-sm btn-secondary btn-icon" onclick="toast('Exporting...','info')"><i class="fa-solid fa-download"></i></button>
  </div>
  <div class="card-body">
    ${tableWrap(`<table><thead><tr><th>#</th><th>Company</th><th style="text-align:right">Total Promo</th></tr></thead><tbody>
    <tr>
      <td>1</td>
      <td><a href="#" onclick="toast('s88pw detail','info')" style="color:var(--acc)">s88pw</a><br><span style="font-size:.72rem;color:var(--text3)">VIGOR S88 Pink White</span></td>
