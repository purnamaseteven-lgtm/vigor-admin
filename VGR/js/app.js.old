/* ─── REAL-TIME WIDGET TIMERS ─── */
let _jackpotInterval = null;
let _countdownInterval = null;
let _jackpotValue = 2847391204;

function startRealTimeWidgets() {
  // Jackpot ticker — increments ~1240 per second
  if (_jackpotInterval) clearInterval(_jackpotInterval);
  _jackpotInterval = setInterval(() => {
    _jackpotValue += rnd(800, 1800);
    document.querySelectorAll('.jk-value').forEach(el => { el.textContent = 'Rp ' + fmt(_jackpotValue); });
  }, 1000);

  // Countdown timer — ticks down every second
  if (_countdownInterval) clearInterval(_countdownInterval);
  let target = Date.now() + (2*86400+14*3600+33*60+7)*1000;
  _countdownInterval = setInterval(() => {
    const rem = Math.max(0, Math.floor((target - Date.now()) / 1000));
    const d=Math.floor(rem/86400), h=Math.floor(rem%86400/3600), m=Math.floor(rem%3600/60), s=rem%60;
    document.querySelectorAll('.cd-num').forEach((el,i) => {
      el.textContent = String([d,h,m,s][i]||0).padStart(2,'0');
    });
  }, 1000);
}

function stopRealTimeWidgets() {
  if (_jackpotInterval) { clearInterval(_jackpotInterval); _jackpotInterval = null; }
  if (_countdownInterval) { clearInterval(_countdownInterval); _countdownInterval = null; }
}

/* ─── INIT ─── */
window.addEventListener('DOMContentLoaded', () => {
  initState();
  go('dashboard');
  toggleMenu('homeMenu', document.querySelector('[onclick="toggleMenu(\'homeMenu\', this)"]'));
  // Start real-time widgets after a short delay
  setTimeout(startRealTimeWidgets, 500);
});
