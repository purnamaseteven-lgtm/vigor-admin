${pageHeader('Pools', '<span>Settings</span><span class="sep">›</span><span>Pools</span>',
  `<button class="btn btn-primary" onclick="toast('Pool added','success')"><i class="fa-solid fa-plus"></i> Add Pool</button>`
)}
<div class="card">
  <div class="card-body">
    ${tableWrap(`<table><thead><tr><th>#</th><th>Pool Name</th><th>Code</th><th>Draw Days</th><th>Close Time</th><th>Open Time</th><th>Status</th><th>Action</th></tr></thead><tbody>
    ${['SINGAPORE','HONGKONG','SYDNEY','PCSO','CAMBODIA','MAGNUM','DAMACAI','TOTO'].map((p,i) => `<tr>
      <td>${i+1}</td><td><strong>${p}</strong></td><td>${p.slice(0,3)}</td>
      <td>${['Mon,Wed,Thu,Sat','Everyday','Mon-Sat','Mon,Wed,Fri','Everyday','Wed,Sat','Wed,Sat','Wed,Sat'][i]}</td>
      <td>18:00</td><td>10:00</td>
      <td><label class="toggle"><input type="checkbox" ${i<5?'checked':''}/><div class="toggle-slider"></div></label></td>
      <td>${actionBtns()}</td>
    </tr>`).join('')}
    </tbody></table>`)}
  </div>
</div>`;

/* ─── SETTINGS: GAMES (Togel game settings) ─── */
function togelGameSettingsContent(showAgentFilter) {
  const GAME_CATS = ['BB CAMPURAN','ANGKA TARUNG','COLOK BEBAS','COLOK BEBAS 2D','COLOK NAGA','COLOK JITU','TEPI - TENGAH','DASAR','50-50','50-50 2D','KOMBINASI','SHIO','SILANG - HOMO'];
  const SUB_TABS = ['DISCOUNT GAME','FULBET','PRIZE 1-2-3','BET BB'];
  const BET_FIELDS = ['MAX BET','MAX BET 2D','MAX BET 2D TENGAH','MAX BET 3D','MAX BET 3D DERHA','MAX BET 4D'];
  const BET_VALS = [500,3000000,3000000,500000,100000,100000];
  const PRIZE_FIELDS = ['WIN 2D /kx','WIN 2D DERHA (x)','WIN 3D TENGAH (x)','WIN 3D (x)','WIN 2D DERHA (x)','WIN 4D /x'];
  const PRIZE_VALS = [70,80,300,400,80,3000];
  const DISC_FIELDS = ['DISCOUNT 2D (%)','DISCOUNT 2D DERHA (%)','DISCOUNT 2D TENGAH (%)','DISCOUNT 3D (%)','DISCOUNT 3D DERHA (%)','DISCOUNT 4D (%)'];
  const DISC_VALS = [29,16,25,59,45,59];

  function settingsForm() {
    return `
      <div style="margin-bottom:.75rem">
        <div style="font-size:.75rem;font-weight:700;color:var(--text2);margin-bottom:.4rem">Bet</div>
        ${BET_FIELDS.map((f,i)=>`
          <div style="display:grid;grid-template-columns:240px 1fr;align-items:center;padding:.3rem 0;border-bottom:1px solid var(--border)">
            <span style="font-size:.78rem;color:var(--text2)">${f}</span>
            <input type="number" value="${BET_VALS[i]}" style="width:160px;border:1px solid var(--border);border-radius:5px;padding:.3rem .5rem;outline:none;font-size:.82rem"/>
          </div>`).join('')}
      </div>
      <div style="margin-bottom:.75rem;margin-top:.5rem">
        <div style="font-size:.75rem;font-weight:700;color:var(--text2);margin-bottom:.4rem">Prize (winning multiplier)</div>
        ${PRIZE_FIELDS.map((f,i)=>`
          <div style="display:grid;grid-template-columns:240px 1fr;align-items:center;padding:.3rem 0;border-bottom:1px solid var(--border)">
            <span style="font-size:.78rem;color:var(--text2)">${f}</span>
            <input type="number" value="${PRIZE_VALS[i]}" style="width:120px;border:1px solid var(--border);border-radius:5px;padding:.3rem .5rem;outline:none;font-size:.82rem"/>
          </div>`).join('')}
      </div>
      <div style="margin-bottom:.75rem;margin-top:.5rem">
        <div style="font-size:.75rem;font-weight:700;color:var(--text2);margin-bottom:.4rem">Discount (%)</div>
        ${DISC_FIELDS.map((f,i)=>`
          <div style="display:grid;grid-template-columns:240px 1fr;align-items:center;padding:.3rem 0;border-bottom:1px solid var(--border)">
            <span style="font-size:.78rem;color:var(--text2)">${f}</span>
            <input type="number" value="${DISC_VALS[i]}" style="width:100px;border:1px solid var(--border);border-radius:5px;padding:.3rem .5rem;outline:none;font-size:.82rem"/>
          </div>`).join('')}
      </div>
      <div style="display:flex;gap:.5rem;margin-top:.75rem">
        <button class="btn btn-success btn-sm" onclick="toast('Settings saved!','success')"><i class="fa-solid fa-check"></i> Save</button>
        <button class="btn btn-secondary btn-sm" onclick="toast('Settings copied!','info')">COPY GAME SETTINGS</button>
      </div>`;
  }

  return `
    <div class="alert alert-info" style="margin-bottom:.75rem;font-size:.78rem">
      <i class="fa-solid fa-circle-info"></i> Note: Save and Reset Save: the new game settings will be applied for all agents on immediately.<br/>
      Customize settings: the new game settings will be applied for one specific agent.
    </div>
    <!-- game category tabs (scrollable) -->
    <div style="overflow-x:auto;white-space:nowrap;border-bottom:1px solid var(--border);margin-bottom:.75rem;padding-bottom:.3rem">
      <span style="font-size:.72rem;font-weight:700;color:var(--acc);margin-right:.15rem">4D / 3D / 2D</span>
      ${GAME_CATS.map((g,i)=>`<span style="font-size:.7rem;color:${i===0?'var(--text)':'var(--text3)'};cursor:pointer;padding:.2rem .55rem;margin-right:.1rem;border-radius:4px;background:${i===0?'var(--bg)':'transparent'}" onclick="this.parentElement.querySelectorAll('span').forEach(s=>s.style.background='transparent');this.style.background='var(--bg)';this.style.color='var(--text)'">${g}</span>`).join('')}
    </div>
    <!-- sub-tabs -->
    <div class="tab-bar" style="margin-bottom:.75rem">
      ${SUB_TABS.map((t,ti)=>`<div class="tab-btn${ti===0?' active':''}" onclick="switchTab(this,'_dummy')">${t}</div>`).join('')}
    </div>
    ${settingsForm()}`;
}

