    ${Array.from({length:10},(_,i) => `<tr>
      <td>${i+1}</td><td>${MEMBERS[i%MEMBERS.length]}</td>
      <td>${COMPANIES[i%COMPANIES.length]}</td><td>${COMPANIES[(i+1)%COMPANIES.length]}</td>
      <td>${fmtCur(rnd(1,50)*100000)}</td><td>27 Apr 2026</td>
      <td>${badge('Transferred','blue')}</td>
    </tr>`).join('')}
    </tbody></table>`)}
    ${pager()}
  </div>
</div>`;

