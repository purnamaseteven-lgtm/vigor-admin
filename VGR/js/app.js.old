/* helper: render a mini live widget preview */
function renderWidgetPreview(id, small = false) {
  const s = small ? 'style="transform:scale(.7);transform-origin:top left;pointer-events:none"' : '';
  switch(id) {
    case 'banner-slider': return `<div class="wp-banner" ${s}><div class="banner-content"><div class="banner-title">🎰 Welcome Bonus 200%</div><div class="banner-sub">Deposit now & get double your money</div><button class="banner-btn">Claim Now</button></div></div>`;
    case 'marquee': return `<div class="wp-marquee" ${s}><span>🔥 HOT: Gates of Olympus pays 5000x &nbsp;&nbsp;&nbsp; 🏆 VIP Tournament — Prize Pool Rp 50,000,000 &nbsp;&nbsp;&nbsp; ⚡ New game: Sweet Bonanza XMAS is live!</span></div>`;
    case 'game-grid': return `<div class="wp-gamegrid" ${s}>${['🎰','🃏','🎲','🎳','🎯','🏆','🎪','🎡'].map((e,i)=>`<div class="game-thumb"><div class="game-bg" style="background:${['#0f172a','#1e293b','#0a0e2e','#162032','#0d1117','#1a0a2e','#1a1a0f','#0f1a0a'][i]};color:#fff">${e}</div><div class="game-overlay"></div></div>`).join('')}</div>`;
    case 'promo-card': return `<div class="wp-promo" ${s}><div class="promo-card"><div class="promo-badge">LIMITED</div><div class="promo-title">New Member Bonus</div><div class="promo-value">100%</div><button class="promo-cta">Claim Bonus</button></div></div>`;
    case 'countdown': return `<div class="wp-countdown" ${s}><div class="cd-title">EVENT ENDS IN</div><div class="cd-boxes"><div class="cd-box"><span class="cd-num">02</span><span class="cd-unit">DAYS</span></div><div class="cd-box"><span class="cd-num">14</span><span class="cd-unit">HRS</span></div><div class="cd-box"><span class="cd-num">33</span><span class="cd-unit">MIN</span></div><div class="cd-box"><span class="cd-num">07</span><span class="cd-unit">SEC</span></div></div></div>`;
    case 'jackpot-ticker': return `<div class="wp-jackpot" ${s}><div><div class="jk-label">🎰 Progressive Jackpot</div></div><div class="jk-value">Rp 2,847,391,204</div></div>`;
    case 'vip-progress': return `<div class="wp-vip" ${s}><div class="vip-row"><div class="vip-avatar">AS</div><div><div class="vip-name">adminsub40</div><div class="vip-tier">⭐ Gold Member</div></div></div><div class="vip-bar-wrap"><div class="vip-bar"></div></div><div class="vip-progress-label"><span>6,500 pts</span><span>10,000 pts for Platinum</span></div></div>`;
    case 'login-form': return `<div class="wp-login" ${s}><div class="lf-title">Sign In</div><input class="lf-input" placeholder="Username"/><input class="lf-input" placeholder="Password" type="password"/><button class="lf-btn">Login</button></div>`;
    case 'register-form': return `<div class="wp-login" ${s}><div class="lf-title">Create Account</div><input class="lf-input" placeholder="Username"/><input class="lf-input" placeholder="Email"/><input class="lf-input" placeholder="Password" type="password"/><button class="lf-btn" style="background:var(--green)">Register</button></div>`;
    case 'footer': return `<div class="wp-footer" ${s}><div class="ft-col"><div class="ft-title">VIGOR</div><span class="ft-link">About Us</span><span class="ft-link">Terms</span><span class="ft-link">Privacy</span></div><div class="ft-col"><div class="ft-title">Support</div><span class="ft-link">Live Chat</span><span class="ft-link">FAQ</span><span class="ft-link">Contact</span></div><div class="ft-col"><div class="ft-title">Follow</div><span class="ft-link">Telegram</span><span class="ft-link">Instagram</span><span class="ft-link">Twitter</span></div></div>`;
    case 'social-links': return `<div class="wp-social" ${s}><div class="sc-btn" style="background:#0088cc"><i class="fa-brands fa-telegram"></i></div><div class="sc-btn" style="background:#e1306c"><i class="fa-brands fa-instagram"></i></div><div class="sc-btn" style="background:#1da1f2"><i class="fa-brands fa-twitter"></i></div><div class="sc-btn" style="background:#25d366"><i class="fa-brands fa-whatsapp"></i></div><div class="sc-btn" style="background:#ff0000"><i class="fa-brands fa-youtube"></i></div></div>`;
    case 'hot-games': return `<div style="padding:.5rem;background:#0f172a" ${s}><div style="color:#ef4444;font-size:.72rem;font-weight:700;margin-bottom:.4rem">🔥 HOT GAMES</div><div style="display:flex;gap:.4rem">${['🎰 Olympus','🍭 Bonanza','🐺 Wolf Gold'].map(g=>`<div style="background:#1e293b;border-radius:6px;padding:.3rem .5rem;font-size:.65rem;color:#fff;white-space:nowrap">${g}</div>`).join('')}</div></div>`;
    case 'announcement': return `<div style="background:#f59e0b;padding:.5rem 1rem;font-size:.78rem;font-weight:600;color:#fff;display:flex;align-items:center;gap:.5rem" ${s}><i class="fa-solid fa-bullhorn"></i> System maintenance scheduled: Sunday 02:00-04:00 WIB</div>`;
    case 'html-block': return `<div style="padding:.75rem;background:#1e293b;font-family:monospace;font-size:.7rem;color:#94a3b8" ${s}>&lt;<span style="color:#38bdf8">div</span> <span style="color:#fbbf24">class</span>=<span style="color:#a3e635">"custom"</span>&gt;<br>&nbsp;&nbsp;&lt;<span style="color:#38bdf8">p</span>&gt;Custom HTML Block&lt;/<span style="color:#38bdf8">p</span>&gt;<br>&lt;/<span style="color:#38bdf8">div</span>&gt;</div>`;
    case 'image-block': return `<div style="background:#f1f5f9;display:flex;align-items:center;justify-content:center;min-height:80px;color:#94a3b8" ${s}><div style="text-align:center"><i class="fa-regular fa-image" style="font-size:2rem;margin-bottom:.25rem;display:block"></i><span style="font-size:.72rem">Image Block</span></div></div>`;
    case 'text-block': return `<div style="padding:.75rem" ${s}><div style="font-size:1rem;font-weight:700;color:var(--text)">Heading Text</div><p style="font-size:.8rem;color:var(--text2);margin-top:.3rem">Your content text goes here. Click to edit this block and customize the message.</p></div>`;
    default: return `<div style="padding:1rem;text-align:center;color:var(--text3)"><i class="fa-solid fa-puzzle-piece" style="font-size:1.5rem"></i><div style="font-size:.75rem;margin-top:.4rem">${id}</div></div>`;
  }
}

/* ─── WIDGET LIBRARY ─── */
pages['widget-library'] = () => {
  const cats = WIDGET_CATS.map((c,i) => `<div class="cat-pill${i===0?' active':''}" onclick="filterWidgets('${c}',this)">${c}</div>`).join('');
  const widgets = WIDGET_DEFS.map(w => `
    <div class="widget-card" id="wcard-${w.id}">
      <div class="widget-preview" style="background:${w.bg}">
        <i class="fa-solid ${w.icon}" style="color:${w.color};font-size:2rem"></i>
        <div class="wp-label">${w.cat}</div>
      </div>
      <div class="widget-info">
        <div class="widget-name">${w.name}</div>
        <div class="widget-type">${w.cat}</div>
      </div>
      <div class="widget-actions">
        <button class="btn btn-sm btn-primary" style="flex:1" onclick="go('widget-configure');pendingWidget='${w.id}'"><i class="fa-solid fa-pen"></i> Configure</button>
        <button class="btn btn-sm btn-secondary btn-icon" onclick="previewWidget('${w.id}')"><i class="fa-solid fa-eye"></i></button>
      </div>
    </div>`).join('');

  const myWidgets = STATE.savedWidgets.length === 0
    ? `<div style="padding:2rem;text-align:center;color:var(--text3);font-size:.85rem"><i class="fa-solid fa-puzzle-piece" style="font-size:2rem;opacity:.4;display:block;margin-bottom:.5rem"></i>No custom widgets yet.<br>Click <strong>Create Widget</strong> to build your first one.</div>`
    : STATE.savedWidgets.map(cw => {
        const def = WIDGET_DEFS.find(x => x.id === cw.type) || WIDGET_DEFS[0];
        return `
        <div class="widget-card">
          <div class="widget-preview" style="background:${def.bg}">
            <i class="fa-solid ${def.icon}" style="color:${def.color};font-size:2rem"></i>
            <div class="wp-label">Custom</div>
          </div>
          <div class="widget-info">
            <div class="widget-name">${cw.name}</div>
            <div class="widget-type">${def.cat} · ${cw.createdAt}</div>
          </div>
          <div class="widget-actions">
            <button class="btn btn-sm btn-primary" style="flex:1" onclick="go('widget-configure');pendingWidget='${cw.type}'"><i class="fa-solid fa-pen"></i> Edit</button>
            <button class="btn btn-sm btn-danger btn-icon" onclick="deleteCustomWidget('${cw.id}')"><i class="fa-solid fa-trash"></i></button>
          </div>
        </div>`;
      }).join('');

  return `
  ${pageHeader('Widget Library', '<span>Customization</span><span class="sep">›</span><span>Widget Library</span>',
    `<button class="btn btn-primary" onclick="go('widget-configure');pendingWidget=null"><i class="fa-solid fa-plus"></i> Create Widget</button>
     <button class="btn btn-secondary" onclick="go('template-builder')"><i class="fa-solid fa-layer-group"></i> Template Builder</button>`
  )}
  <div class="category-pills">${cats}</div>
  <div class="widget-grid" id="widgetGrid">${widgets}</div>
  <div style="margin-top:1.5rem">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem">
      <div style="font-size:.95rem;font-weight:600;color:var(--text)"><i class="fa-solid fa-star text-yellow"></i> My Custom Widgets <span class="badge badge-blue" style="margin-left:.4rem">${STATE.savedWidgets.length}</span></div>
    </div>
    <div class="widget-grid" id="myWidgetGrid">${myWidgets}</div>
  </div>`;
};

let pendingWidget = null;

function filterWidgets(cat, el) {
  document.querySelectorAll('.cat-pill').forEach(p => p.classList.remove('active'));
  el.classList.add('active');
  WIDGET_DEFS.forEach(w => {
    const card = document.getElementById('wcard-' + w.id);
    if (card) card.style.display = (cat === 'All' || w.cat === cat) ? '' : 'none';
  });
}

function previewWidget(id) {
  const w = WIDGET_DEFS.find(x => x.id === id);
  openModal(`Preview: ${w.name}`,
    `<div style="border:1px solid var(--border);border-radius:8px;overflow:hidden;min-height:100px">${renderWidgetPreview(id)}</div>
     <div class="mt-2 text-sm text-muted">Category: <strong>${w.cat}</strong></div>`,
    `<button class="btn btn-primary" onclick="go('widget-configure');pendingWidget='${id}';closeModalBtn()">Configure</button>
     <button class="btn btn-secondary" onclick="closeModalBtn()">Close</button>`
  );
}

/* ─── WIDGET CONFIGURATOR ─── */
pages['widget-configure'] = () => {
  const w = pendingWidget ? WIDGET_DEFS.find(x => x.id === pendingWidget) : null;
  const isNew = !pendingWidget;

  const typeSelector = WIDGET_DEFS.map(wd => `
    <div class="mini-widget" onclick="selectWidgetType('${wd.id}',this)" id="wtype-${wd.id}" style="${w&&w.id===wd.id?'border-color:var(--acc);background:var(--acc-glow)':''}">
      <div class="mini-widget-icon" style="background:${wd.bg}"><i class="fa-solid ${wd.icon}" style="color:${wd.color}"></i></div>
      <div class="mini-widget-info">
        <div class="mw-name">${wd.name}</div>
        <div class="mw-cat">${wd.cat}</div>
      </div>
    </div>`).join('');

  return `
  ${pageHeader(isNew ? 'Create Widget' : `Configure: ${w.name}`,
    `<span>Customization</span><span class="sep">›</span><span><a href="#" onclick="go('widget-library')">Widget Library</a></span><span class="sep">›</span><span>${isNew?'Create':'Configure'}</span>`,
    `<button class="btn btn-secondary" onclick="go('widget-library')"><i class="fa-solid fa-arrow-left"></i> Back</button>
     <button class="btn btn-primary" onclick="saveWidget()"><i class="fa-solid fa-check"></i> Save Widget</button>`
  )}
  <div style="display:grid;grid-template-columns:260px 1fr 280px;gap:1rem;align-items:start">

    <!-- Left: type selector -->
    <div class="wconfig-panel">
      <div class="wconfig-section">
        <div class="wconfig-title"><i class="fa-solid fa-shapes"></i> Widget Type</div>
        <div style="max-height:400px;overflow-y:auto">${typeSelector}</div>
      </div>
    </div>

    <!-- Center: live preview -->
    <div>
      <div class="card mb-2">
        <div class="card-header">
          <span class="card-title">Live Preview</span>
          <div class="flex gap-1">
            <button class="device-btn active" onclick="setPreviewDevice('desktop',this)" title="Desktop"><i class="fa-solid fa-desktop"></i></button>
            <button class="device-btn" onclick="setPreviewDevice('tablet',this)" title="Tablet"><i class="fa-solid fa-tablet-screen-button"></i></button>
            <button class="device-btn" onclick="setPreviewDevice('mobile',this)" title="Mobile"><i class="fa-solid fa-mobile-screen"></i></button>
          </div>
        </div>
        <div class="card-body" style="padding:.75rem">
          <div id="widgetPreviewFrame" style="border:1px solid var(--border);border-radius:8px;overflow:hidden;transition:all .2s;max-width:100%;margin:0 auto">
            ${w ? renderWidgetPreview(w.id) : '<div style="padding:3rem;text-align:center;color:var(--text3)"><i class="fa-solid fa-cursor" style="font-size:2rem;opacity:.4;display:block;margin-bottom:.5rem"></i>Select a widget type</div>'}
          </div>
        </div>
      </div>
      <!-- Widget name -->
      <div class="card">
        <div class="card-body">
          <div class="form-field">
            <label>Widget Name *</label>
            <input type="text" id="widgetNameInput" value="${w ? w.name + ' — Custom' : ''}" placeholder="e.g. Homepage Banner"/>
          </div>
          <div class="form-field mt-1">
            <label>Description (optional)</label>
            <input type="text" placeholder="Internal note about this widget"/>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: properties -->
    <div class="wconfig-panel" id="widgetPropsPanel">
      ${w ? renderWidgetProps(w.id) : '<div class="prop-empty"><i class="fa-solid fa-sliders"></i><p>Select a widget type to configure</p></div>'}
    </div>
  </div>`;
};

function selectWidgetType(id, el) {
  document.querySelectorAll('.mini-widget').forEach(m => {
    m.style.borderColor = ''; m.style.background = '';
  });
  el.style.borderColor = 'var(--acc)'; el.style.background = 'var(--acc-glow)';
  pendingWidget = id;
  const frame = document.getElementById('widgetPreviewFrame');
  if (frame) frame.innerHTML = renderWidgetPreview(id);
  const props = document.getElementById('widgetPropsPanel');
  if (props) props.innerHTML = renderWidgetProps(id);
  const w = WIDGET_DEFS.find(x => x.id === id);
  const ni = document.getElementById('widgetNameInput');
  if (ni && !ni.value) ni.value = w.name + ' — Custom';
}

function setPreviewDevice(device, btn) {
  document.querySelectorAll('.device-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const frame = document.getElementById('widgetPreviewFrame');
  if (!frame) return;
  if (device === 'mobile') frame.style.maxWidth = '375px';
  else if (device === 'tablet') frame.style.maxWidth = '768px';
  else frame.style.maxWidth = '100%';
}

function renderWidgetProps(id) {
  const commonProps = `
    <div class="prop-section">
      <div class="prop-section-title">Visibility</div>
      <div class="prop-row"><label>Show on Desktop</label><label class="toggle"><input type="checkbox" checked/><div class="toggle-slider"></div></label></div>
      <div class="prop-row"><label>Show on Mobile</label><label class="toggle"><input type="checkbox" checked/><div class="toggle-slider"></div></label></div>
    </div>
    <div class="prop-section">
      <div class="prop-section-title">Spacing</div>
      <div class="prop-row"><label>Padding</label><input type="text" value="16px" placeholder="e.g. 16px"/></div>
      <div class="prop-row"><label>Margin Bottom</label><input type="text" value="0" placeholder="e.g. 8px"/></div>
    </div>`;

  const specific = {
    'banner-slider': `
      <div class="prop-section">
        <div class="prop-section-title"><i class="fa-solid fa-images"></i> Banner Settings</div>
        <div class="prop-row"><label>Slide Interval (ms)</label><input type="number" value="4000"/></div>
        <div class="prop-row"><label>Height</label><input type="text" value="400px"/></div>
        <div class="prop-row"><label>Show Dots</label><label class="toggle"><input type="checkbox" checked/><div class="toggle-slider"></div></label></div>
        <div class="prop-row"><label>Show Arrows</label><label class="toggle"><input type="checkbox" checked/><div class="toggle-slider"></div></label></div>
        <div class="prop-row"><label>Auto Play</label><label class="toggle"><input type="checkbox" checked/><div class="toggle-slider"></div></label></div>
      </div>
      <div class="prop-section">
        <div class="prop-section-title">Slide 1</div>
        <div class="prop-row"><label>Title</label><input type="text" value="Welcome Bonus 200%"/></div>
        <div class="prop-row"><label>Subtitle</label><input type="text" value="Deposit now & get double"/></div>
        <div class="prop-row"><label>Button Text</label><input type="text" value="Claim Now"/></div>
        <div class="prop-row"><label>Button Link</label><input type="text" value="/register"/></div>
        <div class="prop-row"><label>Background Color</label><div class="color-input"><input type="color" oninput="syncColorPick(this)" value="#0f172a"/><input type="text" oninput="syncColorText(this)" value="#0f172a"/></div></div>
      </div>`,
    'marquee': `
      <div class="prop-section">
        <div class="prop-section-title"><i class="fa-solid fa-align-justify"></i> Marquee Settings</div>
        <div class="prop-row"><label>Text Content</label><textarea rows="3" placeholder="Scrolling text...">🔥 HOT: Gates of Olympus pays 5000x &nbsp; 🏆 VIP Tournament live now!</textarea></div>
        <div class="prop-row"><label>Speed</label><select><option>Slow</option><option selected>Normal</option><option>Fast</option></select></div>
        <div class="prop-row"><label>Background Color</label><div class="color-input"><input type="color" oninput="syncColorPick(this)" value="#0ea5e9"/><input type="text" oninput="syncColorText(this)" value="#0ea5e9"/></div></div>
        <div class="prop-row"><label>Text Color</label><div class="color-input"><input type="color" oninput="syncColorPick(this)" value="#ffffff"/><input type="text" oninput="syncColorText(this)" value="#ffffff"/></div></div>
      </div>`,
    'game-grid': `
      <div class="prop-section">
        <div class="prop-section-title"><i class="fa-solid fa-grid-2"></i> Game Grid Settings</div>
        <div class="prop-row"><label>Columns</label><select><option>3</option><option selected>4</option><option>5</option><option>6</option></select></div>
        <div class="prop-row"><label>Rows to Show</label><input type="number" value="2"/></div>
        <div class="prop-row"><label>Provider Filter</label><select><option>All Providers</option>${PROVIDERS.slice(1).map(p=>`<option>${p}</option>`).join('')}</select></div>
        <div class="prop-row"><label>Sort By</label><select><option>Hot</option><option>New</option><option>A-Z</option></select></div>
        <div class="prop-row"><label>Show Game Name</label><label class="toggle"><input type="checkbox" checked/><div class="toggle-slider"></div></label></div>
      </div>`,
    'promo-card': `
      <div class="prop-section">
        <div class="prop-section-title"><i class="fa-solid fa-gift"></i> Promotion Settings</div>
        <div class="prop-row"><label>Badge Text</label><input type="text" value="LIMITED"/></div>
        <div class="prop-row"><label>Title</label><input type="text" value="New Member Bonus"/></div>
        <div class="prop-row"><label>Value / Percentage</label><input type="text" value="100%"/></div>
        <div class="prop-row"><label>CTA Button</label><input type="text" value="Claim Bonus"/></div>
        <div class="prop-row"><label>Link URL</label><input type="text" value="/promotions"/></div>
        <div class="prop-row"><label>Gradient Start</label><div class="color-input"><input type="color" oninput="syncColorPick(this)" value="#0ea5e9"/><input type="text" oninput="syncColorText(this)" value="#0ea5e9"/></div></div>
        <div class="prop-row"><label>Gradient End</label><div class="color-input"><input type="color" oninput="syncColorPick(this)" value="#8b5cf6"/><input type="text" oninput="syncColorText(this)" value="#8b5cf6"/></div></div>
      </div>`,
    'countdown': `
      <div class="prop-section">
        <div class="prop-section-title"><i class="fa-solid fa-clock"></i> Countdown Settings</div>
        <div class="prop-row"><label>Title</label><input type="text" value="EVENT ENDS IN"/></div>
        <div class="prop-row"><label>Target Date</label><input type="datetime-local"/></div>
        <div class="prop-row"><label>Background Color</label><div class="color-input"><input type="color" oninput="syncColorPick(this)" value="#0f172a"/><input type="text" oninput="syncColorText(this)" value="#0f172a"/></div></div>
        <div class="prop-row"><label>Number Color</label><div class="color-input"><input type="color" oninput="syncColorPick(this)" value="#0ea5e9"/><input type="text" oninput="syncColorText(this)" value="#0ea5e9"/></div></div>
        <div class="prop-row"><label>On Expire Action</label><select><option>Hide Widget</option><option>Show Message</option><option>Redirect</option></select></div>
      </div>`,
    'jackpot-ticker': `
      <div class="prop-section">
        <div class="prop-section-title"><i class="fa-solid fa-dollar-sign"></i> Jackpot Settings</div>
        <div class="prop-row"><label>Label</label><input type="text" value="🎰 Progressive Jackpot"/></div>
        <div class="prop-row"><label>Starting Value (Rp)</label><input type="number" value="2000000000"/></div>
        <div class="prop-row"><label>Increment per Second</label><input type="number" value="1240"/></div>
        <div class="prop-row"><label>Currency Symbol</label><input type="text" value="Rp"/></div>
      </div>`,
    'vip-progress': `
      <div class="prop-section">
        <div class="prop-section-title"><i class="fa-solid fa-crown"></i> VIP Bar Settings</div>
        <div class="prop-row"><label>Show Avatar</label><label class="toggle"><input type="checkbox" checked/><div class="toggle-slider"></div></label></div>
        <div class="prop-row"><label>Show Points</label><label class="toggle"><input type="checkbox" checked/><div class="toggle-slider"></div></label></div>
        <div class="prop-row"><label>Bar Color Start</label><div class="color-input"><input type="color" oninput="syncColorPick(this)" value="#0ea5e9"/><input type="text" oninput="syncColorText(this)" value="#0ea5e9"/></div></div>
        <div class="prop-row"><label>Bar Color End</label><div class="color-input"><input type="color" oninput="syncColorPick(this)" value="#8b5cf6"/><input type="text" oninput="syncColorText(this)" value="#8b5cf6"/></div></div>
      </div>`,
    'login-form': `
      <div class="prop-section">
        <div class="prop-section-title"><i class="fa-solid fa-right-to-bracket"></i> Login Form</div>
        <div class="prop-row"><label>Title</label><input type="text" value="Sign In"/></div>
        <div class="prop-row"><label>Show Captcha</label><label class="toggle"><input type="checkbox" checked/><div class="toggle-slider"></div></label></div>
        <div class="prop-row"><label>Show Forgot Password</label><label class="toggle"><input type="checkbox" checked/><div class="toggle-slider"></div></label></div>
        <div class="prop-row"><label>Button Color</label><div class="color-input"><input type="color" oninput="syncColorPick(this)" value="#0ea5e9"/><input type="text" oninput="syncColorText(this)" value="#0ea5e9"/></div></div>
        <div class="prop-row"><label>Redirect After Login</label><input type="text" value="/dashboard"/></div>
      </div>`,
  };

  const content = specific[id] || `
    <div class="prop-section">
      <div class="prop-section-title"><i class="fa-solid fa-sliders"></i> ${WIDGET_DEFS.find(w=>w.id===id)?.name} Settings</div>
      <div class="prop-row"><label>Background Color</label><div class="color-input"><input type="color" oninput="syncColorPick(this)" value="#ffffff"/><input type="text" oninput="syncColorText(this)" value="#ffffff"/></div></div>
      <div class="prop-row"><label>Text Color</label><div class="color-input"><input type="color" oninput="syncColorPick(this)" value="#0f172a"/><input type="text" oninput="syncColorText(this)" value="#0f172a"/></div></div>
      <div class="prop-row"><label>Custom CSS Class</label><input type="text" placeholder="my-widget"/></div>
    </div>`;

  return content + commonProps;
}

function saveWidget() {
  const name = (document.getElementById('widgetNameInput')?.value || '').trim();
  if (!pendingWidget) { toast('Please select a widget type first', 'error'); return; }
  if (!name) { toast('Please enter a widget name', 'error'); document.getElementById('widgetNameInput')?.focus(); return; }
  // Collect all prop inputs from the props panel
  const props = {};
  document.querySelectorAll('#widgetPropsPanel input, #widgetPropsPanel select, #widgetPropsPanel textarea').forEach(el => {
    if (el.type === 'checkbox') props[el.closest('.prop-row')?.querySelector('label:first-child')?.textContent?.trim() || el.name || 'check'] = el.checked;
    else if (el.type === 'color') { /* skip — captured by adjacent text */ }
    else if (el.value) props[el.placeholder || el.type || 'val'] = el.value;
  });
  stateSaveWidget(pendingWidget, name, props);
  toast(`Widget "${name}" saved!`, 'success');
  setTimeout(() => go('widget-library'), 800);
}

/* ═══════════════════════════════
   TEMPLATE BUILDER
═══════════════════════════════ */

const LAYOUTS = {
  classic: {
    name: 'Classic',
    zones: [
      { id:'z-announce', label:'Announcement', full:true, height:'44px' },
      { id:'z-header',   label:'Header / Nav', full:true, height:'70px' },
      { id:'z-hero',     label:'Hero Banner',  full:true, height:'200px' },
      { id:'z-marquee',  label:'Marquee',      full:true, height:'44px' },
      { id:'z-jackpot',  label:'Jackpot Ticker',full:true,height:'60px' },
      { id:'z-games',    label:'Game Grid',    full:true, height:'200px' },
      { id:'z-promo',    label:'Promotions',   full:true, height:'140px' },
      { id:'z-footer',   label:'Footer',       full:true, height:'120px' },
    ]
  },
  sidebar: {
    name: 'Sidebar',
    zones: [
      { id:'z-header',  label:'Header',       full:true, height:'70px' },
      { id:'z-marquee', label:'Marquee',       full:true, height:'44px' },
      { id:'z-main',    label:'Main Content',  cols:3, height:'300px' },
      { id:'z-side',    label:'Sidebar',       cols:1, height:'300px' },
      { id:'z-footer',  label:'Footer',        full:true, height:'120px' },
    ]
  },
  landing: {
    name: 'Landing',
    zones: [
      { id:'z-header', label:'Header',          full:true, height:'70px' },
      { id:'z-hero',   label:'Hero (Full)',      full:true, height:'300px' },
      { id:'z-feat1',  label:'Feature 1',        cols:1, height:'140px' },
      { id:'z-feat2',  label:'Feature 2',        cols:1, height:'140px' },
      { id:'z-feat3',  label:'Feature 3',        cols:1, height:'140px' },
      { id:'z-cta',    label:'Call to Action',   full:true, height:'100px' },
      { id:'z-footer', label:'Footer',           full:true, height:'120px' },
    ]
  },
  minimal: {
    name: 'Minimal',
    zones: [
      { id:'z-header',  label:'Header',  full:true, height:'70px' },
      { id:'z-content', label:'Content', full:true, height:'400px' },
      { id:'z-footer',  label:'Footer',  full:true, height:'90px' },
    ]
  }
};

pages['template-builder'] = () => {
  // Only reset if explicitly requested (changeLayout does its own reset)
  builderState.activeZone = null;
  return renderBuilderPage();
};

function renderBuilderPage() {
  const layout = LAYOUTS[builderState.layout];
  const layoutPicker = Object.entries(LAYOUTS).map(([key, l]) => `
    <div class="layout-opt${builderState.layout===key?' active':''}" onclick="changeLayout('${key}')">
      <div class="lo-preview">${layoutPreviewSVG(key)}</div>
      <div class="lo-name">${l.name}</div>
    </div>`).join('');

  const customWidgetItems = STATE.savedWidgets.map(cw => {
    const def = WIDGET_DEFS.find(x => x.id === cw.type) || WIDGET_DEFS[0];
    return `
    <div class="mini-widget" onclick="assignWidgetToZone('${cw.type}')" style="border-color:var(--acc);position:relative">
      <div class="mini-widget-icon" style="background:${def.bg}"><i class="fa-solid ${def.icon}" style="color:${def.color}"></i></div>
      <div class="mini-widget-info">
        <div class="mw-name">${cw.name}</div>
        <div class="mw-cat" style="color:var(--acc)">★ Custom</div>
      </div>
    </div>`;
  }).join('');

  const miniWidgets = (customWidgetItems ? `<div style="font-size:.7rem;font-weight:600;color:var(--acc);margin-bottom:.3rem;padding:.2rem 0;border-bottom:1px solid var(--border)">★ MY WIDGETS</div>${customWidgetItems}<div style="font-size:.7rem;font-weight:600;color:var(--text3);margin:.5rem 0 .3rem;padding:.2rem 0;border-bottom:1px solid var(--border)">ALL WIDGETS</div>` : '') +
    WIDGET_DEFS.map(w => `
    <div class="mini-widget" onclick="assignWidgetToZone('${w.id}')">
      <div class="mini-widget-icon" style="background:${w.bg}"><i class="fa-solid ${w.icon}" style="color:${w.color}"></i></div>
      <div class="mini-widget-info">
        <div class="mw-name">${w.name}</div>
        <div class="mw-cat">${w.cat}</div>
      </div>
    </div>`).join('');

  const canvas = buildCanvas(layout);

  const savedTplMenu = STATE.savedLayouts.length === 0 ? '' : `
    <div style="position:relative;display:inline-block">
      <button class="btn btn-secondary" onclick="toggleSavedTplMenu(this)"><i class="fa-solid fa-folder-open"></i> Load <i class="fa-solid fa-chevron-down" style="font-size:.7rem;margin-left:.25rem"></i></button>
      <div id="savedTplMenu" style="display:none;position:absolute;right:0;top:110%;min-width:200px;background:var(--surface);border:1px solid var(--border);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.4);z-index:999;padding:.4rem 0">
        ${STATE.savedLayouts.map(tpl => `
          <div style="display:flex;align-items:center;gap:.5rem;padding:.45rem .75rem;cursor:pointer;font-size:.82rem" onmouseover="this.style.background='var(--hover)'" onmouseout="this.style.background=''">
            <div style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" onclick="loadSavedTemplate('${tpl.id}')">${tpl.name}</div>
            <span style="font-size:.7rem;color:var(--text3);flex-shrink:0">${tpl.layout}</span>
            <button class="btn btn-sm btn-danger btn-icon" style="padding:.2rem .3rem;font-size:.65rem" onclick="event.stopPropagation();deleteTemplate('${tpl.id}')"><i class="fa-solid fa-trash"></i></button>
          </div>`).join('')}
      </div>
    </div>`;

  return `
  ${pageHeader('Template Builder',
    '<span>Customization</span><span class="sep">›</span><span>Template Builder</span>',
    `<input type="text" id="tplName" value="${builderState.templateName}" style="border:1px solid var(--border);border-radius:7px;padding:.4rem .75rem;font-size:.85rem;width:200px;outline:none"/>
     ${savedTplMenu}
     <button class="btn btn-secondary" onclick="go('template-preview')"><i class="fa-solid fa-eye"></i> Preview</button>
     <button class="btn btn-primary" onclick="saveTemplate()"><i class="fa-solid fa-floppy-disk"></i> Save</button>`
  )}
  <div class="builder-layout" id="builderLayout">

    <!-- LEFT PANEL: Widgets -->
    <div class="builder-panel">
      <div class="builder-panel-header">
        <span><i class="fa-solid fa-puzzle-piece"></i> Widgets</span>
        <button class="btn btn-sm btn-primary btn-icon" onclick="go('widget-configure');pendingWidget=null" title="New Widget"><i class="fa-solid fa-plus"></i></button>
      </div>
      <div class="builder-panel-body">
        <div style="margin-bottom:.5rem">
          <div class="search-box" style="width:100%">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Search widgets..." style="width:100%" oninput="filterBuilderWidgets(this.value)"/>
          </div>
        </div>
        <div id="builderWidgetList">${miniWidgets}</div>
      </div>
    </div>

    <!-- CENTER: Canvas -->
    <div style="display:flex;flex-direction:column;gap:.75rem;padding:.75rem;overflow-y:auto">
      <!-- Toolbar -->
      <div class="builder-toolbar">
        <span class="tb-label">Layout:</span>
        <div class="layout-picker" style="margin:0;grid-template-columns:repeat(4,auto);gap:.35rem">${layoutPicker}</div>
        <div style="margin-left:auto;display:flex;align-items:center;gap:.5rem">
          <span class="tb-label">Device:</span>
          <button class="device-btn${builderState.device==='desktop'?' active':''}" onclick="setBuilderDevice('desktop',this)"><i class="fa-solid fa-desktop"></i></button>
          <button class="device-btn${builderState.device==='tablet'?' active':''}" onclick="setBuilderDevice('tablet',this)"><i class="fa-solid fa-tablet-screen-button"></i></button>
          <button class="device-btn${builderState.device==='mobile'?' active':''}" onclick="setBuilderDevice('mobile',this)"><i class="fa-solid fa-mobile-screen"></i></button>
          <button class="btn btn-sm btn-danger ms-1" onclick="clearCanvas()" title="Clear all zones"><i class="fa-solid fa-trash"></i></button>
        </div>
      </div>

      <!-- Canvas frame -->
      <div id="builderCanvasWrap" style="display:flex;justify-content:center">
        <div class="builder-canvas" id="builderCanvas" style="width:${builderState.device==='desktop'?'100%':builderState.device==='tablet'?'768px':'375px'}">
          ${canvas}
        </div>
      </div>

      <div class="text-sm text-muted" style="text-align:center"><i class="fa-solid fa-info-circle"></i> Click a zone to select it, then click a widget from the left panel to assign</div>

      ${STATE.savedLayouts.length > 0 ? `
      <div style="border-top:1px solid var(--border);margin-top:.75rem;padding-top:.75rem">
        <div style="font-size:.8rem;font-weight:600;color:var(--text2);margin-bottom:.5rem"><i class="fa-solid fa-folder"></i> Saved Templates (${STATE.savedLayouts.length})</div>
        <div style="display:flex;flex-wrap:wrap;gap:.4rem">
          ${STATE.savedLayouts.map(tpl => `
            <div style="display:flex;align-items:center;gap:.3rem;background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:.3rem .6rem;font-size:.78rem">
              <span style="cursor:pointer;color:var(--acc)" onclick="loadSavedTemplate('${tpl.id}')">${tpl.name}</span>
              <span style="color:var(--text3)">${tpl.layout}</span>
              <button onclick="deleteTemplate('${tpl.id}')" style="background:none;border:none;color:var(--red);cursor:pointer;padding:0;font-size:.7rem"><i class="fa-solid fa-xmark"></i></button>
            </div>`).join('')}
        </div>
      </div>` : ''}
    </div>

    <!-- RIGHT PANEL: Properties -->
    <div class="builder-panel">
      <div class="builder-panel-header"><span><i class="fa-solid fa-sliders"></i> Properties</span></div>
      <div class="builder-panel-body" id="builderPropsPanel">
        <div class="prop-empty"><i class="fa-solid fa-hand-pointer"></i><p>Click a zone on the canvas to configure it</p></div>
      </div>
    </div>
  </div>`;
}

function layoutPreviewSVG(key) {
  const previews = {
    classic: `<div class="lo-preview"><div class="lo-row"></div><div class="lo-row" style="height:8px"></div><div class="lo-row"></div><div class="lo-row" style="height:8px"></div><div class="lo-row" style="height:8px"></div></div>`,
    sidebar: `<div class="lo-preview"><div class="lo-row"></div><div class="lo-cols"><div class="lo-col wide"></div><div class="lo-col"></div></div><div class="lo-row"></div></div>`,
    landing: `<div class="lo-preview"><div class="lo-row"></div><div class="lo-row" style="height:8px"></div><div class="lo-cols"><div class="lo-col"></div><div class="lo-col"></div><div class="lo-col"></div></div><div class="lo-row"></div></div>`,
    minimal: `<div class="lo-preview"><div class="lo-row"></div><div class="lo-row" style="height:12px"></div><div class="lo-row"></div></div>`,
  };
  return previews[key] || '';
}

function buildCanvas(layout) {
  let html = '';
  const zones = layout.zones;

  if (builderState.layout === 'sidebar') {
    html += zones.filter(z=>z.full).slice(0,2).map(z => zoneHTML(z)).join('');
    const cols = zones.filter(z=>z.cols);
    if (cols.length) {
      html += `<div style="display:grid;grid-template-columns:3fr 1fr">
        ${cols.map(z => zoneHTML(z)).join('')}
      </div>`;
    }
    html += zones.filter(z=>z.full).slice(2).map(z => zoneHTML(z)).join('');
  } else if (builderState.layout === 'landing') {
    zones.slice(0,2).forEach(z => html += zoneHTML(z));
    const feats = zones.slice(2,5);
    if (feats.length === 3) {
      html += `<div style="display:grid;grid-template-columns:1fr 1fr 1fr">${feats.map(z=>zoneHTML(z)).join('')}</div>`;
    }
    zones.slice(5).forEach(z => html += zoneHTML(z));
  } else {
    zones.forEach(z => html += zoneHTML(z));
  }
  return html;
}

function zoneHTML(z) {
  const wid = builderState.zones[z.id];
  const isActive = builderState.activeZone === z.id;
  const hasWidget = !!wid;
  const w = wid ? WIDGET_DEFS.find(x => x.id === wid) : null;
  return `
    <div class="zone${hasWidget?' has-widget':''}${isActive?' active':''}"
         id="zone-${z.id}" style="height:${z.height};position:relative"
         onclick="selectZone('${z.id}')">
      ${!hasWidget ? `<div class="zone-label">${z.label}</div>` : ''}
      ${hasWidget ? `
        <button class="zone-remove" onclick="removeFromZone(event,'${z.id}')"><i class="fa-solid fa-xmark"></i></button>
        <div style="height:100%;overflow:hidden">${renderWidgetPreview(wid)}</div>
      ` : `
        <button class="zone-add-btn" onclick="event.stopPropagation();selectZone('${z.id}')"><i class="fa-solid fa-plus"></i></button>
        <div class="zone-content">
          <i class="fa-solid fa-plus-circle" style="color:var(--border);font-size:1.5rem"></i>
          <div style="font-size:.68rem;color:var(--text3)">${z.label}</div>
        </div>
      `}
    </div>`;
}

function selectZone(zoneId) {
  builderState.activeZone = builderState.activeZone === zoneId ? null : zoneId;
  refreshCanvas();
  updateBuilderProps(zoneId);
}

function assignWidgetToZone(widgetId) {
  if (!builderState.activeZone) {
    toast('Click a zone on the canvas first, then select a widget', 'info');
    return;
  }
  builderState.zones[builderState.activeZone] = widgetId;
  const w = WIDGET_DEFS.find(x => x.id === widgetId);
  toast(`${w.name} assigned to zone!`, 'success');
  builderState.activeZone = null;
  refreshCanvas();
  document.getElementById('builderPropsPanel').innerHTML = '<div class="prop-empty"><i class="fa-solid fa-hand-pointer"></i><p>Click a zone on the canvas to configure it</p></div>';
}

function removeFromZone(e, zoneId) {
  e.stopPropagation();
  delete builderState.zones[zoneId];
  refreshCanvas();
  toast('Widget removed from zone', 'info');
}

function refreshCanvas() {
  const layout = LAYOUTS[builderState.layout];
  const canvas = document.getElementById('builderCanvas');
  if (canvas) canvas.innerHTML = buildCanvas(layout);
}

function changeLayout(key) {
  builderState.layout = key;
  builderState.zones = {};
  builderState.activeZone = null;
  const container = document.getElementById('builderLayout');
  if (container) { go('template-builder'); return; }
  refreshCanvas();
}

function setBuilderDevice(dev, btn) {
  builderState.device = dev;
  document.querySelectorAll('.device-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const canvas = document.getElementById('builderCanvas');
  if (!canvas) return;
  canvas.style.width = dev === 'desktop' ? '100%' : dev === 'tablet' ? '768px' : '375px';
}

function clearCanvas() {
  if (!confirm('Clear all widgets from canvas?')) return;
  builderState.zones = {};
  refreshCanvas();
  toast('Canvas cleared', 'info');
}

function updateBuilderProps(zoneId) {
  const panel = document.getElementById('builderPropsPanel');
  if (!panel) return;
  const wid = builderState.zones[zoneId];
  const layout = LAYOUTS[builderState.layout];
  const zone = layout.zones.find(z => z.id === zoneId);
  if (!zone) return;
  panel.innerHTML = `
    <div class="prop-section">
      <div class="prop-section-title">Zone: ${zone.label}</div>
      <div class="prop-row"><label>Zone ID</label><input type="text" value="${zoneId}" readonly/></div>
      <div class="prop-row"><label>Height</label><input type="text" value="${zone.height}" onchange="updateZoneHeight('${zoneId}',this.value)"/></div>
      <div class="prop-row"><label>Background</label><div class="color-input"><input type="color" oninput="syncColorPick(this)" value="#0a0e1a" oninput="syncColorPick(this)"/><input type="text" oninput="syncColorText(this)" value="#0a0e1a" oninput="syncColorText(this)"/></div></div>
    </div>
    ${wid ? `
    <div class="prop-section">
      <div class="prop-section-title">Assigned Widget</div>
      <div class="mini-widget" style="border-color:var(--acc)">
        <div class="mini-widget-icon" style="background:${WIDGET_DEFS.find(x=>x.id===wid)?.bg}">
          <i class="fa-solid ${WIDGET_DEFS.find(x=>x.id===wid)?.icon}" style="color:${WIDGET_DEFS.find(x=>x.id===wid)?.color}"></i>
        </div>
        <div class="mini-widget-info">
          <div class="mw-name">${WIDGET_DEFS.find(x=>x.id===wid)?.name}</div>
          <div class="mw-cat">${WIDGET_DEFS.find(x=>x.id===wid)?.cat}</div>
        </div>
      </div>
      <button class="btn btn-sm btn-danger w-full mt-1" onclick="removeFromZone({stopPropagation:()=>{}},'${zoneId}')"><i class="fa-solid fa-trash"></i> Remove Widget</button>
    </div>
    ${renderWidgetProps(wid)}` : `
    <div class="prop-empty">
      <i class="fa-solid fa-puzzle-piece"></i>
      <p>No widget assigned.<br>Select a widget from the left panel.</p>
    </div>`}`;
}

function filterBuilderWidgets(query) {
  const q = query.toLowerCase();
  document.querySelectorAll('#builderWidgetList .mini-widget').forEach(el => {
    const name = el.querySelector('.mw-name')?.textContent?.toLowerCase() || '';
    const cat  = el.querySelector('.mw-cat')?.textContent?.toLowerCase() || '';
    el.style.display = (!q || name.includes(q) || cat.includes(q)) ? '' : 'none';
  });
}

function saveTemplate() {
  const name = (document.getElementById('tplName')?.value || 'Template').trim();
  if (!name) { toast('Please enter a template name', 'error'); return; }
  builderState.templateName = name;
  const count = Object.keys(builderState.zones).length;
  stateSaveLayout(name, builderState.layout, builderState.zones);
  toast(`Template "${name}" saved — ${count} widget${count !== 1 ? 's' : ''}!`, 'success');
}

/* ─── TEMPLATE PREVIEW ─── */
pages['template-preview'] = () => {
  const layout = LAYOUTS[builderState.layout];
  const renderedZones = layout.zones.map(z => {
    const wid = builderState.zones[z.id];
    if (!wid) return `<div style="min-height:${z.height};background:repeating-linear-gradient(45deg,#f8fafc,#f8fafc 10px,#fff 10px,#fff 20px);display:flex;align-items:center;justify-content:center;color:#cbd5e1;font-size:.75rem">${z.label} (empty)</div>`;
    return `<div style="min-height:${z.height}">${renderWidgetPreview(wid)}</div>`;
  });

  let canvasContent = '';
  if (builderState.layout === 'sidebar') {
    const fullTop = layout.zones.filter(z=>z.full).slice(0,2);
    const cols = layout.zones.filter(z=>z.cols);
    const fullBottom = layout.zones.filter(z=>z.full).slice(2);
    canvasContent = fullTop.map(z => renderedZones[layout.zones.indexOf(z)]).join('') +
      `<div style="display:grid;grid-template-columns:3fr 1fr">${cols.map(z => renderedZones[layout.zones.indexOf(z)]).join('')}</div>` +
      fullBottom.map(z => renderedZones[layout.zones.indexOf(z)]).join('');
  } else if (builderState.layout === 'landing') {
    canvasContent = renderedZones.slice(0,2).join('') +
      `<div style="display:grid;grid-template-columns:1fr 1fr 1fr">${renderedZones.slice(2,5).join('')}</div>` +
      renderedZones.slice(5).join('');
  } else {
    canvasContent = renderedZones.join('');
  }

  return `
  ${pageHeader('Template Preview', '<span>Customization</span><span class="sep">›</span><span>Preview</span>',
    `<button class="btn btn-secondary" onclick="go('template-builder')"><i class="fa-solid fa-arrow-left"></i> Back to Builder</button>
     <button class="btn btn-primary" onclick="saveTemplate()"><i class="fa-solid fa-floppy-disk"></i> Save Template</button>`
  )}
  <div class="preview-toolbar">
    <span class="font-semibold">${builderState.templateName}</span>
    <div style="margin-left:auto;display:flex;gap:.4rem">
      <button class="device-btn active" id="pvDesktop" onclick="setPvDevice('100%',this)"><i class="fa-solid fa-desktop"></i></button>
      <button class="device-btn" id="pvTablet" onclick="setPvDevice('768px',this)"><i class="fa-solid fa-tablet-screen-button"></i></button>
      <button class="device-btn" id="pvMobile" onclick="setPvDevice('375px',this)"><i class="fa-solid fa-mobile-screen"></i></button>
    </div>
    <div style="display:flex;align-items:center;gap:.5rem;margin-left:.75rem">
      <span class="text-sm text-muted">Zoom:</span>
      <select onchange="setPreviewZoom(this.value)" style="border:1px solid var(--border);border-radius:6px;padding:.3rem .5rem;font-size:.78rem">
        <option value="1">100%</option><option value=".75">75%</option><option value=".5">50%</option>
      </select>
    </div>
  </div>
  <div style="display:flex;justify-content:center;overflow-x:auto;padding-bottom:1rem">
    <div class="preview-frame" id="pvFrame" style="width:100%;overflow:hidden">
      <div id="pvContent" style="transform-origin:top left;transition:transform .2s">
        ${canvasContent}
      </div>
    </div>
  </div>`;
};

function setPvDevice(w, btn) {
  document.querySelectorAll('#pvDesktop,#pvTablet,#pvMobile').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  const frame = document.getElementById('pvFrame');
  if (frame) frame.style.width = w;
}
function setPreviewZoom(v) {
  const content = document.getElementById('pvContent');
  if (content) content.style.transform = `scale(${v})`;
}

/* ─── SAVED TEMPLATE HELPERS ─── */
function toggleSavedTplMenu(btn) {
  const menu = document.getElementById('savedTplMenu');
  if (!menu) return;
  const isOpen = menu.style.display !== 'none';
  menu.style.display = isOpen ? 'none' : 'block';
  if (!isOpen) {
    const close = (e) => { if (!btn.contains(e.target) && !menu.contains(e.target)) { menu.style.display = 'none'; document.removeEventListener('click', close); } };
    setTimeout(() => document.addEventListener('click', close), 0);
  }
}

function loadSavedTemplate(id) {
  const tpl = STATE.savedLayouts.find(t => t.id === id);
  if (!tpl) return;
  builderState.layout = tpl.layout;
  builderState.zones = Object.assign({}, tpl.zones);
  builderState.templateName = tpl.name;
  go('template-builder');
  toast(`Loaded template "${tpl.name}"`, 'success');
}

function deleteTemplate(id) {
  const tpl = STATE.savedLayouts.find(t => t.id === id);
  if (!tpl) return;
  if (!confirm(`Delete template "${tpl.name}"?`)) return;
  STATE.savedLayouts = STATE.savedLayouts.filter(t => t.id !== id);
  go('template-builder');
  toast('Template deleted', 'info');
}

/* ─── CUSTOM WIDGET HELPERS ─── */
function deleteCustomWidget(id) {
  const cw = STATE.savedWidgets.find(w => w.id === id);
  if (!cw) return;
  if (!confirm(`Delete widget "${cw.name}"?`)) return;
  STATE.savedWidgets = STATE.savedWidgets.filter(w => w.id !== id);
  go('widget-library');
  toast('Widget deleted', 'info');
}

/* ─── ZONE HEIGHT ─── */
function updateZoneHeight(zoneId, val) {
  const layout = LAYOUTS[builderState.layout];
  const zone = layout.zones.find(z => z.id === zoneId);
  if (zone && val) {
    zone.height = val;
    const el = document.getElementById('zone-' + zoneId);
    if (el) el.style.height = val;
  }
}

/* ─── COLOR INPUT SYNC ─── */
function syncColorPick(colorEl) {
  const row = colorEl.closest('.color-input');
  if (!row) return;
  const text = row.querySelector('input[type="text"]');
  if (text) text.value = colorEl.value;
}
function syncColorText(textEl) {
  const row = textEl.closest('.color-input');
  if (!row) return;
  const pick = row.querySelector('input[type="color"]');
  if (pick && /^#[0-9a-fA-F]{6}$/.test(textEl.value)) pick.value = textEl.value;
}

/* ─── MEMBER ACTIONS ─── */
function addMember() {
  openFormModal('Add New Member',[
    {name:'username',label:'Username',required:true,placeholder:'e.g. user_123'},
    {name:'name',label:'Full Name',required:true,placeholder:'Full name'},
    {name:'company',label:'Company',type:'select',options:COMPANIES,value:COMPANIES[0]},
    {name:'phone',label:'Phone',placeholder:'08xxxxxxxxx'},
    {name:'bank',label:'Bank',type:'select',options:BANKS,value:BANKS[0]},
    {name:'bankAccount',label:'Account Number',placeholder:'10-digit number'},
    {name:'status',label:'Status',type:'select',options:STATUSES,value:'Active'},
  ],()=>{
    const u=fmVal('username').trim();
    if (!u){toast('Username is required','error');return;}
    if (STATE.members.some(m=>m.username===u)){toast('Username already exists','error');return;}
    stateAdd('members',{id:'M'+String(Date.now()).slice(-6),username:u,name:fmVal('name'),
      company:fmVal('company'),phone:fmVal('phone'),bank:fmVal('bank'),bankAccount:fmVal('bankAccount'),
      balance:0,status:fmVal('status'),joined:new Date().toLocaleDateString('id-ID'),lastLogin:'—',ip:'0.0.0.0'});
    addLog('Add Member',u,'Created member: '+fmVal('name'));
    closeModalBtn();go(currentPage);toast('Member added!','success');
  },{cols:2});
}

function editMember(id) {
  const m=STATE.members.find(x=>x.id===id);if(!m)return;
  openFormModal('Edit Member',[
    {name:'id',hidden:true,value:m.id},
    {name:'username',label:'Username',value:m.username,readonly:true},
    {name:'name',label:'Full Name',value:m.name},
    {name:'company',label:'Company',type:'select',options:COMPANIES,value:m.company},
    {name:'phone',label:'Phone',value:m.phone},
    {name:'bank',label:'Bank',type:'select',options:BANKS,value:m.bank},
    {name:'bankAccount',label:'Account Number',value:m.bankAccount},
    {name:'status',label:'Status',type:'select',options:STATUSES,value:m.status},
  ],()=>{
    stateUpdate('members',fmVal('id'),{name:fmVal('name'),company:fmVal('company'),phone:fmVal('phone'),
      bank:fmVal('bank'),bankAccount:fmVal('bankAccount'),status:fmVal('status')});
    addLog('Edit Member',fmVal('username')||fmVal('id'),'Member profile updated');
    closeModalBtn();go(currentPage);toast('Member updated!','success');
  },{cols:2,saveLabel:'Update'});
}

function deleteMember(id) {
  const m=STATE.members.find(x=>x.id===id);if(!m)return;
  if(!confirm(`Delete member "${m.username}"?`))return;
  stateDelete('members',id);addLog('Delete Member',m.username,'Member deleted');go(currentPage);toast('Member deleted','info');
}

function toggleMemberStatus(id) {
  const m=STATE.members.find(x=>x.id===id);if(!m)return;
  const next=m.status==='Active'?'Inactive':'Active';
  stateUpdate('members',id,{status:next});addLog('Update Member Status',m.username,`Status → ${next}`);go(currentPage);toast(`${m.username} → ${next}`,'info');
}

