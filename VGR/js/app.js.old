pages['tier-history'] = () => `
${pageHeader('Tier History for Member', '<span>Members</span><span class="sep">›</span><span>Tier History</span>')}
${filterCard(`${filterInput('Username','Enter username')} ${filterDate('From')} ${filterDate('To')} ${filterActions()}`)}
<div class="card">
  <div class="card-body">
    ${tableWrap(`<table><thead><tr><th>#</th><th>Username</th><th>Old Tier</th><th>New Tier</th><th>Changed By</th><th>Date</th></tr></thead><tbody>
    ${MEMBERS.slice(0,10).map((m,i) => `<tr>
      <td>${i+1}</td><td>${m}</td>
      <td>${badge(['Bronze','Silver','Gold','Platinum'][i%4],'gray')}</td>
      <td>${badge(['Silver','Gold','Platinum','Diamond'][i%4],'blue')}</td>
      <td>adminsub40</td>
      <td>2${rnd(5,7)} Apr 2026</td>
    </tr>`).join('')}
    </tbody></table>`)}
  </div>
</div>`;

/* ─── BANK CREATE ─── */
pages['bank-create'] = () => `
${pageHeader('Create Bank', '<span>Bank Management</span><span class="sep">›</span><span>Create</span>')}
<div class="form-card">
  <div class="card-header"><span class="card-title">Bank Account Information</span></div>
  <div class="card-body">
    <div class="form-grid">
      <div class="form-grid form-grid-2">
        <div class="form-field"><label>Bank Name *</label><select>${BANKS.map(b=>`<option>${b}</option>`).join('')}</select></div>
        <div class="form-field"><label>Account Name *</label><input type="text" placeholder="Account holder name"/></div>
      </div>
      <div class="form-grid form-grid-2">
        <div class="form-field"><label>Account Number *</label><input type="text" placeholder="Enter account number"/></div>
        <div class="form-field"><label>Account Type</label><select><option>Deposit</option><option>Withdraw</option><option>Both</option></select></div>
      </div>
      <div class="form-grid form-grid-2">
        <div class="form-field"><label>Min Deposit</label><input type="number" placeholder="0"/></div>
        <div class="form-field"><label>Max Deposit</label><input type="number" placeholder="0"/></div>
      </div>
      <div class="form-field"><label>Status</label><select><option>Active</option><option>Inactive</option></select></div>
    </div>
  </div>
  <div class="form-footer">
    <button class="btn btn-primary" onclick="toast('Bank created!','success');go('bank-list')"><i class="fa-solid fa-check"></i> Create</button>
    <button class="btn btn-secondary" onclick="go('bank-list')">Cancel</button>
  </div>
</div>`;

/* ─── BANK LIST ─── */
pages['bank-list'] = () => {
  const pg='bank-list', pp=getPerPage(pg), cp=getCurPage(pg);
  const all=filterData(STATE.banks,pg);
  const rows=paginate(all,cp,pp).map((b,i)=>`
    <tr>
      <td>${(cp-1)*pp+i+1}</td>
      <td><strong>${b.bank}</strong></td>
      <td>${b.accountName}</td>
      <td>${b.accountNumber}</td>
      <td>${badge(b.type,b.type.includes('Deposit')?'blue':b.type.includes('Withdrawal')?'yellow':'green')}</td>
      <td>${fmtCur(b.minDeposit)}</td>
      <td>${fmtCur(b.maxDeposit)}</td>
      <td>${badge(b.status,b.status==='Active'?'green':'red')}</td>
      <td>
        <div class="action-btns">
          <button class="btn btn-sm btn-primary btn-icon" onclick="editBank('${b.id}')"><i class="fa-solid fa-pen"></i></button>
          <button class="btn btn-sm btn-danger btn-icon" onclick="deleteBank('${b.id}')"><i class="fa-solid fa-trash"></i></button>
          <button class="btn btn-sm btn-secondary btn-icon" onclick="toggleBankStatus('${b.id}')"><i class="fa-solid fa-toggle-on"></i></button>
        </div>
      </td>
    </tr>`).join('');
  return `
  ${pageHeader('Bank List','<span>Bank Management</span>',
    `<button class="btn btn-primary" onclick="addBank()"><i class="fa-solid fa-plus"></i> Add Bank</button>`)}
  ${filterCard(`
    ${fsInput(pg,'_search','Search','Bank / Account name')}
    ${fsSelect(pg,'status','Status',['All','Active','Inactive'])}
    ${fsSelect(pg,'type','Type',['All','Deposit Only','Withdrawal Only','Both'])}
    ${fsActions(pg)}
  `)}
  <div class="card">
    <div class="card-header"><span class="card-title">Bank List</span><span class="text-sm text-muted">${all.length} accounts</span></div>
    <div class="card-body">
      ${tableWrap(`<table><thead><tr><th>#</th><th>Bank</th><th>Account Name</th><th>Account No.</th><th>Type</th><th>Min</th><th>Max</th><th>Status</th><th>Action</th></tr></thead><tbody>${rows||'<tr><td colspan="9" style="text-align:center;color:var(--text3)">No records</td></tr>'}</tbody></table>`)}
      ${renderPagerHTML(pg,all.length,pp,cp)}
    </div>
  </div>`;
};

/* ─── DEPOSIT MANAGEMENT ─── */
pages['deposit-list'] = () => {
  const pg='deposit-list', pp=getPerPage(pg), cp=getCurPage(pg);
  const all=filterData(STATE.deposits,pg);
  const pending=STATE.deposits.filter(d=>d.status==='Pending').length;
  const todayApproved=STATE.deposits.filter(d=>d.date.includes('27/4/2026')||d.date.includes('27 Apr')).length;
  const totalAmt=all.reduce((s,d)=>s+(d.status==='Approved'?d.amount:0),0);
  const rows=paginate(all,cp,pp).map((d,i)=>`
    <tr>
      <td>${(cp-1)*pp+i+1}</td>
      <td><strong>${d.id}</strong></td>
      <td><strong>${d.member}</strong></td>
      <td>${d.company}</td>
      <td>${d.bank}</td>
      <td class="text-green" style="font-weight:700">${fmtCur(d.amount)}</td>
      <td>${badge(d.status,d.status==='Approved'?'green':d.status==='Rejected'?'red':'yellow')}</td>
      <td style="font-size:.75rem;white-space:nowrap">${d.date}</td>
      <td style="font-size:.75rem">${d.processedBy}</td>
      <td>
        ${d.status==='Pending'?`<div class="action-btns">
          <button class="btn btn-sm btn-success" onclick="approveDeposit('${d.id}')"><i class="fa-solid fa-check"></i> Approve</button>
          <button class="btn btn-sm btn-danger" onclick="rejectDeposit('${d.id}')"><i class="fa-solid fa-xmark"></i> Reject</button>
        </div>`:`<span style="font-size:.75rem;color:var(--text3)">${d.processedBy}</span>`}
      </td>
    </tr>`).join('');
  return `
  ${pageHeader('Deposit Management','<span>Finance</span><span class="sep">›</span><span>Deposit</span>',`<button class="btn btn-secondary btn-sm" onclick="exportCSV(STATE.deposits,'deposits.csv')"><i class="fa-solid fa-download"></i> Export</button>`+
    `<div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
      <span style="background:rgba(234,179,8,.15);color:#ca8a04;border:1px solid rgba(234,179,8,.3);border-radius:20px;padding:.25rem .75rem;font-size:.8rem;font-weight:600"><i class="fa-solid fa-clock"></i> Pending: ${pending}</span>
      <span style="background:rgba(16,185,129,.15);color:#059669;border:1px solid rgba(16,185,129,.3);border-radius:20px;padding:.25rem .75rem;font-size:.8rem;font-weight:600"><i class="fa-solid fa-check"></i> Total Approved: ${fmtCur(totalAmt)}</span>
    </div>`
  )}
  ${filterCard(`
    ${fsInput(pg,'_search','Search','Member / Company','180px')}
    ${fsSelect(pg,'status','Status',['All','Pending','Approved','Rejected'])}
    ${fsSelect(pg,'bank','Bank',['All',...BANKS],'150px')}
    ${fsActions(pg)}
  `)}
  <div class="card">
    <div class="card-header"><span class="card-title">Deposit Transactions</span><span class="text-sm text-muted">${all.length} records</span></div>
    <div class="card-body">
      ${tableWrap(`<table><thead><tr><th>#</th><th>ID</th><th>Member</th><th>Company</th><th>Bank</th><th>Amount</th><th>Status</th><th>Date</th><th>By</th><th>Action</th></tr></thead><tbody>${rows||'<tr><td colspan="10" style="text-align:center;color:var(--text3)">No records</td></tr>'}</tbody></table>`)}
      ${renderPagerHTML(pg,all.length,pp,cp)}
    </div>
  </div>`;
};

/* ─── WITHDRAWAL MANAGEMENT ─── */
pages['withdrawal-list'] = () => {
  const pg='withdrawal-list', pp=getPerPage(pg), cp=getCurPage(pg);
  const all=filterData(STATE.withdrawals,pg);
  const pending=STATE.withdrawals.filter(w=>w.status==='Pending').length;
  const totalAmt=all.reduce((s,w)=>s+(w.status==='Approved'?w.amount:0),0);
  const rows=paginate(all,cp,pp).map((w,i)=>`
    <tr>
      <td>${(cp-1)*pp+i+1}</td>
      <td><strong>${w.id}</strong></td>
      <td><strong>${w.member}</strong></td>
      <td>${w.company}</td>
      <td>${w.bank}</td>
      <td style="font-size:.75rem">${w.accountNumber}</td>
      <td class="text-red" style="font-weight:700">${fmtCur(w.amount)}</td>
      <td>${badge(w.status,w.status==='Approved'?'green':w.status==='Rejected'?'red':'yellow')}</td>
      <td style="font-size:.75rem;white-space:nowrap">${w.date}</td>
      <td>
        ${w.status==='Pending'?`<div class="action-btns">
          <button class="btn btn-sm btn-success" onclick="approveWithdrawal('${w.id}')"><i class="fa-solid fa-check"></i> Approve</button>
          <button class="btn btn-sm btn-danger" onclick="rejectWithdrawal('${w.id}')"><i class="fa-solid fa-xmark"></i> Reject</button>
        </div>`:`<span style="font-size:.75rem;color:var(--text3)">${w.processedBy}</span>`}
      </td>
    </tr>`).join('');
  return `
  ${pageHeader('Withdrawal Management','<span>Finance</span><span class="sep">›</span><span>Withdrawal</span>',`<button class="btn btn-secondary btn-sm" onclick="exportCSV(STATE.withdrawals,'withdrawals.csv')"><i class="fa-solid fa-download"></i> Export</button>`+
    `<div style="display:flex;gap:.5rem;align-items:center">
      <span style="background:rgba(234,179,8,.15);color:#ca8a04;border:1px solid rgba(234,179,8,.3);border-radius:20px;padding:.25rem .75rem;font-size:.8rem;font-weight:600"><i class="fa-solid fa-clock"></i> Pending: ${pending}</span>
      <span style="background:rgba(239,68,68,.15);color:#dc2626;border:1px solid rgba(239,68,68,.3);border-radius:20px;padding:.25rem .75rem;font-size:.8rem;font-weight:600"><i class="fa-solid fa-arrow-up"></i> Total Out: ${fmtCur(totalAmt)}</span>
    </div>`
  )}
  ${filterCard(`
    ${fsInput(pg,'_search','Search','Member / Company','180px')}
    ${fsSelect(pg,'status','Status',['All','Pending','Approved','Rejected'])}
    ${fsSelect(pg,'bank','Bank',['All',...BANKS],'150px')}
    ${fsActions(pg)}
  `)}
  <div class="card">
    <div class="card-header"><span class="card-title">Withdrawal Transactions</span><span class="text-sm text-muted">${all.length} records</span></div>
    <div class="card-body">
      ${tableWrap(`<table><thead><tr><th>#</th><th>ID</th><th>Member</th><th>Company</th><th>Bank</th><th>Account No.</th><th>Amount</th><th>Status</th><th>Date</th><th>Action</th></tr></thead><tbody>${rows||'<tr><td colspan="10" style="text-align:center;color:var(--text3)">No records</td></tr>'}</tbody></table>`)}
      ${renderPagerHTML(pg,all.length,pp,cp)}
    </div>
  </div>`;
};

/* ─── BETS TABLE ─── */
pages['bets-table'] = () => {
  const GAME_TYPES = ['DISCOUNT 4D','DISCOUNT 3D','DISCOUNT 2D','2D DERHA','3D TENGAH','FULBET 4D','FULBET 3D','FULBET 2D','ANGKA TARUNG','BECAMPURAN','BETBE 40'];
  const COMBOS = ['BECAMPURAN','ANGKA TARUNG','BETBE','FULBET','DERHA','TENGAH','DASAR'];
  const rows = GAME_TYPES.map(g => {
    const items = Array.from({length:rnd(6,14)}, (_,i) => `${COMBOS[i%COMBOS.length]}-${g.replace(/\s/g,'-')}`);
    return `<div style="padding:.35rem 0;border-bottom:1px solid var(--border);display:flex;flex-wrap:wrap;gap:.3rem;align-items:center">
      <span style="font-size:.72rem;font-weight:700;color:var(--acc);min-width:140px;flex-shrink:0">${g}</span>
      ${items.map(it=>`<span style="font-size:.65rem;color:var(--text2);background:var(--bg);border:1px solid var(--border);border-radius:3px;padding:.1rem .35rem;white-space:nowrap">${it}</span>`).join('')}
    </div>`;
  }).join('');
  return `
  ${pageHeader('Bets Table', '<span>Bets</span><span class="sep">›</span><span>Table</span>')}
  ${filterCard(`
    <div class="filter-group"><label>Togel Type</label>
      <div style="display:flex;gap:.75rem;align-items:center;padding:.4rem 0">
        <label style="display:flex;align-items:center;gap:.3rem;font-size:.82rem;cursor:pointer"><input type="radio" name="bttype" checked/> 4D</label>
        <label style="display:flex;align-items:center;gap:.3rem;font-size:.82rem;cursor:pointer"><input type="radio" name="bttype"/> 6D</label>
      </div>
    </div>
    ${filterSelect('Select pool',['Select pool','SINGAPORE','HONGKONG','SYDNEY','PCSO','CAMBODIA'],'180px')}
    ${filterSelect('Period',['Select Period','2026-04-27','2026-04-26','2026-04-25'],'160px')}
    ${filterInput('Username','Username')}
    ${filterActions()}
  `)}
  <div class="card">
    <div class="card-body" style="padding:.5rem 1rem">
      ${rows}
    </div>
  </div>`;
};

/* ─── BETS LIST ─── */
pages['bets-list'] = () => {
  const rows = Array.from({length:20},(_,i) => {
    const bet = rnd(1,20)*5000; const paid = i%4===0?rnd(1,3)*bet:0;
    const disc = (bet*rnd(25,65)/100).toFixed(0);
    const win = i%4===0?rnd(1,5)*bet:0;
    return `<tr>
      <td>${i+1}</td>
      <td style="font-size:.72rem">27 Apr 2026 ${rnd(10,23)}:${rnd(10,59)}:${rnd(10,59)}</td>
      <td style="font-size:.7rem">202.${rnd(100,200)}.${rnd(1,255)}.${rnd(1,254)}</td>
      <td style="font-size:.78rem">${MEMBERS[i%MEMBERS.length]}</td>
      <td style="font-size:.72rem">${rnd(1000,9999)}</td>
      <td style="font-size:.72rem">${GAMES[i%GAMES.length]}</td>
      <td style="font-size:.72rem;font-weight:700">${rnd(1000,9999)}</td>
      <td style="text-align:right">${fmt(bet)}</td>
      <td style="text-align:right">${fmt(paid)}</td>
      <td style="text-align:right">${fmt(disc)}</td>
      <td style="text-align:right;color:${win>0?'var(--green)':'var(--text2)'}">${fmt(win)}</td>
      <td>${badge(i%4===0?'Win':i%4===1?'Lose':i%4===2?'Draw':'Pending',i%4===0?'green':i%4===1?'red':i%4===2?'blue':'yellow')}</td>
    </tr>`;
  }).join('');
  return `
  ${pageHeader('Bets List', '<span>Bets</span><span class="sep">›</span><span>List</span>')}
  <div class="filter-card">
    <div class="filter-row">
      <div class="filter-group"><label>Togel Type</label>
        <div style="display:flex;gap:.75rem;align-items:center;padding:.4rem 0">
          <label style="display:flex;align-items:center;gap:.3rem;font-size:.82rem;cursor:pointer"><input type="radio" name="bltype" checked/> 4D</label>
          <label style="display:flex;align-items:center;gap:.3rem;font-size:.82rem;cursor:pointer"><input type="radio" name="bltype"/> 6D</label>
        </div>
      </div>
      ${filterSelect('Select pools',['Select pools','SE-SE-SEOUL','HK-HONGKONG','SY-SYDNEY','PCSO'],'180px')}
      ${filterSelect('Period',['Select period','2026-04-27','2026-04-26'],'160px')}
      ${filterSelect('Game',['All Games',...GAMES],'160px')}
      ${filterInput('Username','Username','140px')}
      ${filterSelect('Sort',['Date','Bet','Win'],'120px')}
      ${filterSelect('Sort Order',['DESC','ASC'],'110px')}
      ${filterActions()}
    </div>
  </div>
  <div class="card">
    <div class="card-header">
      <span class="card-title">Bets List</span>
      <div class="flex gap-1">
        <button class="btn btn-sm btn-secondary btn-icon" onclick="toast('Exporting...','info')"><i class="fa-solid fa-file-excel"></i></button>
        <button class="btn btn-sm btn-secondary btn-icon" onclick="toast('Printing...','info')"><i class="fa-solid fa-print"></i></button>
      </div>
    </div>
    <div class="card-body">
      <!-- Summary stats -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:1rem">
        <div style="background:var(--bg);border-radius:8px;padding:.6rem .875rem">
          <div style="font-size:.75rem;font-weight:700;color:var(--text);margin-bottom:.35rem">Total Bets</div>
          <div style="display:flex;justify-content:space-between;font-size:.75rem">
            <span style="color:var(--text2)">Total Bets</span><span style="font-weight:600">${fmt(rnd(100,500))}</span>
          </div>
          <div style="display:flex;justify-content:space-between;font-size:.75rem;margin-top:.2rem">
            <span style="color:var(--text2)">Total Bet Transactions</span><span style="font-weight:600">${fmt(rnd(500,2000))}</span>
          </div>
        </div>
        <div style="background:var(--bg);border-radius:8px;padding:.6rem .875rem">
          <div style="font-size:.75rem;font-weight:700;color:var(--text);margin-bottom:.35rem">Maximum / Minimum Bet</div>
          <div style="display:flex;justify-content:space-between;font-size:.75rem">
            <span style="color:var(--text2)">Maximum Bet</span><span style="font-weight:600;color:var(--green)">${fmt(rnd(50000,500000))}</span>
          </div>
          <div style="display:flex;justify-content:space-between;font-size:.75rem;margin-top:.2rem">
            <span style="color:var(--text2)">Minimum Bet</span><span style="font-weight:600">${fmt(rnd(1000,10000))}</span>
          </div>
        </div>
      </div>
      ${tableWrap(`<table><thead><tr><th>#</th><th>Date</th><th>IP Address</th><th>Username</th><th>Period</th><th>Game</th><th>Guess</th><th style="text-align:right">Bet</th><th style="text-align:right">Paid Amount</th><th style="text-align:right">Discount/Kei</th><th style="text-align:right">WIN</th><th>Status</th></tr></thead><tbody>
      ${rows}
      </tbody></table>`)}
      <div style="margin-top:.75rem">
        <select style="border:1px solid var(--border);border-radius:6px;padding:.3rem .5rem;font-size:.78rem;outline:none">
          <option>100</option><option>50</option><option>30</option>
        </select>
      </div>
    </div>
  </div>`;
};

/* ─── BETS TRANSFERRED ─── */
pages['bets-transferred'] = () => `
${pageHeader('Transferred Bets', '<span>Bets</span><span class="sep">›</span><span>Transferred</span>')}
${filterCard(`${filterDate('From')} ${filterDate('To')} ${filterInput('Username','Username')} ${filterActions()}`)}
<div class="card">
  <div class="card-body">
