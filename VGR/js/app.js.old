/* ─── DEPOSIT/WITHDRAWAL ACTIONS ─── */
function approveDeposit(id) {
  if(!confirm('Approve this deposit?'))return;
  const d=STATE.deposits.find(x=>x.id===id);
  stateUpdate('deposits',id,{status:'Approved',processedBy:'adminsub40'});
  addLog('Approve Deposit',id,'Member: '+(d?.member||'')+'  Amount: '+fmtCur(d?.amount||0));
  go(currentPage);toast('Deposit approved!','success');
}
function rejectDeposit(id) {
  if(!confirm('Reject this deposit?'))return;
  const d=STATE.deposits.find(x=>x.id===id);
  stateUpdate('deposits',id,{status:'Rejected',processedBy:'adminsub40'});
  addLog('Reject Deposit',id,'Member: '+(d?.member||'')+'  Amount: '+fmtCur(d?.amount||0));
  go(currentPage);toast('Deposit rejected','info');
}
