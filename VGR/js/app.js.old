function refTogelContent() {
  const TOGEL_GAMES = ['4D / 3D / 2D','BB CAMPURAN','ANGKA TARUNG','COLOK BEBAS','COLOK BEBAS 2D','COLOK NAGA','COLOK JITU','TEPI - TENGAH','DASAR','50-50','50-50 2D','KOMBINASI','SHIO','SILANG - HOMO','KEMBANG - KEMPIS'];
  const DEFAULT_VALS = [2,2.5,0,5,1.7,0.96,0.95,1.02,1.02,1,1,1.12,5,1.06,1];
  const rows = TOGEL_GAMES.map((g,i) => `<tr><td style="font-size:.82rem">${g}</td><td><div style="display:flex;align-items:center;gap:.35rem"><input type="number" value="${DEFAULT_VALS[i]}" step="0.01" style="flex:1;border:1px solid var(--border);border-radius:5px;padding:.3rem .5rem;text-align:right;outline:none;max-width:120px"/><span style="font-size:.8rem;color:var(--text2)">%</span></div></td></tr>`).join('');
  return `<div class="alert" style="background:#fef9c3;border:1px solid #fde047;border-radius:7px;padding:.5rem .875rem;font-size:.78rem;color:#854d0e;margin-bottom:.875rem">*New referral rate will be applied immediately</div>
    <div style="display:flex;gap:.3rem;margin-bottom:.875rem"><button class="btn btn-primary btn-sm">4D</button><button class="btn btn-secondary btn-sm">6D</button></div>
    <div class="table-wrapper"><table><thead><tr><th>Game</th><th>Value (%)</th></tr></thead><tbody>${rows}</tbody></table></div>
    <div style="margin-top:.75rem"><button class="btn btn-primary btn-sm" onclick="toast('Saved!','success')"><i class="fa-solid fa-check"></i> Save</button></div>`;
}
function refGameContent() {
  const games = ['Slot','Live Casino','Sportbook','Poker','Lottery','E-Sports'];
  const vals = [0.5,0.3,0.4,0.2,0.5,0.3];
  const rows = games.map((g,i)=>`<tr><td style="font-size:.82rem">${g}</td><td><div style="display:flex;align-items:center;gap:.35rem"><input type="number" value="${vals[i]}" step="0.01" style="flex:1;border:1px solid var(--border);border-radius:5px;padding:.3rem .5rem;text-align:right;outline:none;max-width:120px"/><span style="font-size:.8rem;color:var(--text2)">%</span></div></td></tr>`).join('');
  return `<div class="alert" style="background:#fef9c3;border:1px solid #fde047;border-radius:7px;padding:.5rem .875rem;font-size:.78rem;color:#854d0e;margin-bottom:.875rem">*New referral rate will be applied immediately</div>
    <div class="table-wrapper"><table><thead><tr><th>Game</th><th>Value (%)</th></tr></thead><tbody>${rows}</tbody></table></div>
    <div style="margin-top:.75rem"><button class="btn btn-primary btn-sm" onclick="toast('Saved!','success')"><i class="fa-solid fa-check"></i> Save</button></div>`;
}

