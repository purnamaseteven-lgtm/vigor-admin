      ${rows}
      <tr style="font-weight:700;background:var(--bg)"><td colspan="5">Grand Total</td><td style="text-align:right;color:var(--green)">${fmt(rnd(5,30)*1000000)}</td></tr>
      </tbody></table>`)}
