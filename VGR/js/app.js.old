pages['custom-app-notification'] = () => {
  const pg='custom-app-notification', pp=getPerPage(pg), cp=getCurPage(pg);
  const all=filterData(STATE.notifications,pg);
  const rows=paginate(all,cp,pp).map((n,i)=>`<tr>
    <td>${(cp-1)*pp+i+1}</td>
    <td style="white-space:nowrap;font-size:.75rem">${n.date}</td>
    <td style="max-width:200px"><a href="#" onclick="return false" style="color:var(--acc);font-size:.78rem">${n.title}</a></td>
    <td style="max-width:300px;font-size:.75rem;color:var(--text2)">${n.content}</td>
    <td>${badge(n.target,'blue')}</td>
    <td>
      <div class="action-btns">
        <button class="btn btn-sm btn-icon" style="background:var(--green);color:#fff" onclick="editNotification('${n.id}')"><i class="fa-solid fa-pen"></i></button>
        <button class="btn btn-sm btn-danger btn-icon" onclick="deleteNotification('${n.id}')"><i class="fa-solid fa-trash"></i></button>
      </div>
    </td>
  </tr>`).join('');
  return `
  ${pageHeader('App Notification List','<span>Customization</span><span class="sep">›</span><span>App Notification</span>',
    `<button class="btn btn-success btn-sm" onclick="addNotification()"><i class="fa-solid fa-plus"></i> Add Notification</button>`)}
  ${filterCard(`${fsInput(pg,'_search','Search','Title / Target','200px')} ${fsActions(pg)}`)}
  <div class="card">
    <div class="card-header"><span class="card-title">App Notification List</span><span class="text-sm text-muted">${all.length} records</span><button class="btn btn-sm btn-secondary btn-icon" onclick="exportCSV(STATE.notifications,'notifications.csv')"><i class="fa-solid fa-download"></i></button></div>
    <div class="card-body">
      ${tableWrap(`<table><thead><tr><th>#</th><th>Created Date</th><th>Title</th><th>Content</th><th>Target</th><th>Action</th></tr></thead><tbody>${rows||'<tr><td colspan="6" style="text-align:center;color:var(--text3)">No notifications</td></tr>'}</tbody></table>`)}
      ${renderPagerHTML(pg,all.length,pp,cp)}
    </div>
  </div>`;
};

function addNotification() {
  openFormModal('Add Notification',[
    {name:'title',label:'Title',required:true,placeholder:'Notification title'},
    {name:'content',label:'Content',type:'textarea',placeholder:'Notification content…'},
    {name:'target',label:'Target (Whitelabel / Company)',placeholder:'e.g. s88pw, All',value:'All'},
  ],()=>{
    const t=fmVal('title').trim();if(!t){toast('Title required','error');return;}
    const now=new Date().toLocaleString('id-ID',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'});
    stateAdd('notifications',{id:'NOT'+String(Date.now()).slice(-4),date:now,title:t,content:fmVal('content'),target:fmVal('target')||'All'});
    addLog('Add Notification',t,'Target: '+fmVal('target'));
    closeModalBtn();go(currentPage);toast('Notification added!','success');
  });
}

function editNotification(id) {
  const n=STATE.notifications.find(x=>x.id===id);if(!n)return;
  openFormModal('Edit Notification',[
    {name:'id',hidden:true,value:n.id},
    {name:'title',label:'Title',value:n.title},
    {name:'content',label:'Content',type:'textarea',value:n.content},
    {name:'target',label:'Target',value:n.target},
  ],()=>{
    stateUpdate('notifications',fmVal('id'),{title:fmVal('title'),content:fmVal('content'),target:fmVal('target')});
    addLog('Edit Notification',n.title,'Updated');
    closeModalBtn();go(currentPage);toast('Updated!','success');
  },{saveLabel:'Update'});
}

function deleteNotification(id) {
  const n=STATE.notifications.find(x=>x.id===id);if(!n)return;
  if(!confirm('Delete this notification?'))return;
  stateDelete('notifications',id);addLog('Delete Notification',n.title,'Deleted');
  go(currentPage);toast('Deleted','info');
}

