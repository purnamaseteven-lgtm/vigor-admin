function stateSaveWidget(type, name, props) {
  const e=STATE.savedWidgets.findIndex(w=>w.name===name&&w.type===type);
  const r={id:'cw_'+Date.now(),name,type,props:props||{},createdAt:new Date().toLocaleString('id-ID')};
  if (e>=0) STATE.savedWidgets[e]=r; else STATE.savedWidgets.push(r);
}
function stateSaveLayout(name, layout, zones) {
  const e=STATE.savedLayouts.findIndex(l=>l.name===name);
  const r={id:'tpl_'+Date.now(),name,layout,zones:Object.assign({},zones),createdAt:new Date().toLocaleString('id-ID')};
  if (e>=0) STATE.savedLayouts[e]=r; else STATE.savedLayouts.push(r);
}

/* ─── CRUD INFRASTRUCTURE ─── */
let _modalSaveFn = null;
function fmVal(id) { const el=document.getElementById('fm_'+id); return el?(el.type==='checkbox'?el.checked:el.value):''; }

function openFormModal(title, fields, onSave, opts={}) {
  _modalSaveFn = onSave;
  const rows = fields.map(f => {
    if (f.hidden) return `<input type="hidden" id="fm_${f.name}" value="${String(f.value||'').replace(/"/g,'&quot;')}"/>`;
    let inp='';
    if (f.type==='select') {
      inp=`<select id="fm_${f.name}">${(f.options||[]).map(o=>`<option ${o===(f.value||'')?'selected':''}>${o}</option>`).join('')}</select>`;
    } else if (f.type==='textarea') {
      inp=`<textarea id="fm_${f.name}" rows="3" placeholder="${f.placeholder||''}">${f.value||''}</textarea>`;
    } else {
      inp=`<input type="${f.type||'text'}" id="fm_${f.name}" value="${String(f.value||'').replace(/"/g,'&quot;')}" placeholder="${f.placeholder||''}" ${f.readonly?'readonly':''}/>`;
    }
    return `<div class="form-field" style="margin-bottom:.65rem"><label style="display:block;font-size:.78rem;font-weight:600;margin-bottom:.25rem;color:var(--text2)">${f.label}${f.required?'<span style="color:var(--red);margin-left:2px">*</span>':''}</label>${inp}</div>`;
  }).join('');
  openModal(title,`<div style="${opts.cols===2?'display:grid;grid-template-columns:1fr 1fr;gap:0 1rem':''}">${rows}</div>`,
    `<button class="btn btn-primary" onclick="_modalSaveFn()"><i class="fa-solid fa-check"></i> ${opts.saveLabel||'Save'}</button>
     <button class="btn btn-secondary" onclick="closeModalBtn()">Cancel</button>`);
}

function stateAdd(key,rec) { STATE[key].unshift(rec); }
function stateUpdate(key,id,data) { const i=STATE[key].findIndex(r=>r.id===id); if(i>=0) STATE[key][i]=Object.assign({},STATE[key][i],data); }
function stateDelete(key,id) { STATE[key]=STATE[key].filter(r=>r.id!==id); }

function addLog(action, target='', description='', actor='adminsub40') {
  const now=new Date().toLocaleString('id-ID',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit',second:'2-digit'});
  STATE.logs.unshift({id:'LOG'+Date.now(),date:now,actor,ip:'192.168.'+rnd(1,10)+'.'+rnd(1,254),action,target,description,userType:'admin'});
  if(STATE.logs.length>500)STATE.logs=STATE.logs.slice(0,500);
}

function exportCSV(data, filename) {
  if(!data||!data.length){toast('No data to export','info');return;}
  const keys=Object.keys(data[0]).filter(k=>!k.startsWith('_')&&k!=='id');
  const lines=[keys.join(',')];
  data.forEach(r=>lines.push(keys.map(k=>{const v=r[k]??'';const s=String(v).replace(/"/g,'""');return /[,"\n]/.test(s)?`"${s}"`:s;}).join(',')));
  const a=document.createElement('a');
  a.href='data:text/csv;charset=utf-8,﻿'+encodeURIComponent(lines.join('\n'));
  a.download=filename||'export.csv';a.click();
  toast('Exported to CSV!','success');
}

function getFilter(pg,k,def='') { return (STATE._filters[pg]||{})[k]??def; }
function setFilter(pg,k,v) { if(!STATE._filters[pg])STATE._filters[pg]={}; STATE._filters[pg][k]=v; STATE._page[pg]=1; go(currentPage); }
function resetFilters(pg) { STATE._filters[pg]={}; STATE._page[pg]=1; go(currentPage); }

function getCurPage(k) { return STATE._page[k]||1; }
function getPerPage(k) { return STATE._perPage[k]||10; }
function setPerPage(k,n) { STATE._perPage[k]=parseInt(n); STATE._page[k]=1; go(currentPage); }
function goToPage(k,n) { STATE._page[k]=n; go(currentPage); }
function paginate(data,pg,pp) { const s=(pg-1)*pp; return data.slice(s,s+pp); }

function renderPagerHTML(key, total, perPage, curPage) {
  const pages=Math.ceil(total/perPage)||1;
  if(pages<=1) return `<div class="pagination"><span style="font-size:.78rem;color:var(--text3)">Total: ${total} records</span></div>`;
  let btns='', last=0;
  for(let i=1;i<=pages;i++) {
    if(i===1||i===pages||Math.abs(i-curPage)<=1) {
      if(last&&i-last>1) btns+=`<span style="padding:0 .25rem;color:var(--text3)">…</span>`;
      btns+=`<button class="page-btn${i===curPage?' active':''}" onclick="goToPage('${key}',${i})">${i}</button>`;
      last=i;
    }
  }
  return `<div class="pagination">
    <button class="page-btn" ${curPage<=1?'disabled':''} onclick="goToPage('${key}',${curPage-1})"><i class="fa-solid fa-chevron-left"></i></button>
    ${btns}
    <button class="page-btn" ${curPage>=pages?'disabled':''} onclick="goToPage('${key}',${curPage+1})"><i class="fa-solid fa-chevron-right"></i></button>
    <select onchange="setPerPage('${key}',this.value)" style="margin-left:.5rem;border:1px solid var(--border);border-radius:6px;padding:.25rem .5rem;font-size:.75rem">
      ${[10,25,50].map(n=>`<option ${n===perPage?'selected':''}>${n}/page</option>`).join('')}
    </select>
    <span style="color:var(--text3);font-size:.78rem;margin-left:.5rem">Total: ${total}</span>
  </div>`;
}

function filterData(arr, pg) {
  const f=STATE._filters[pg]||{};
  return arr.filter(r=>{
    for(const [k,v] of Object.entries(f)) {
      if(!v||v==='All'||v==='') continue;
      if(k==='_search') { const q=v.toLowerCase(); if(!Object.values(r).some(fv=>typeof fv==='string'&&fv.toLowerCase().includes(q))) return false; }
      else if(!(r[k]||'').toString().toLowerCase().includes(v.toLowerCase())) return false;
    }
    return true;
  });
}

function fsInput(pg,k,label,ph='',w='160px') {
  return `<div class="filter-group" style="min-width:${w}"><label>${label}</label><input type="text" value="${getFilter(pg,k,'')}" placeholder="${ph}" oninput="setFilter('${pg}','${k}',this.value)"/></div>`;
}
function fsSelect(pg,k,label,opts,w='140px') {
  const cur=getFilter(pg,k,'All');
  return `<div class="filter-group" style="min-width:${w}"><label>${label}</label><select onchange="setFilter('${pg}','${k}',this.value)">${opts.map(o=>`<option ${o===cur?'selected':''}>${o}</option>`).join('')}</select></div>`;
}
function fsActions(pg,extra='') {
  return `<div class="filter-actions" style="align-self:flex-end">${extra}<button class="btn btn-secondary" onclick="resetFilters('${pg}')"><i class="fa-solid fa-rotate-left"></i> Reset</button></div>`;
}

function makeDates(days) {
  const res = []; const now = new Date('2026-04-27');
  for (let i = days - 1; i >= 0; i--) {
    const d = new Date(now); d.setDate(d.getDate() - i);
    res.push(d.toLocaleDateString('id-ID', { day:'2-digit', month:'short' }));
  } return res;
}
function makeData(n, min, max) { return Array.from({length:n}, () => rnd(min, max)); }

